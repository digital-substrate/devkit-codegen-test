// The namespace holding the types with no dependency: everything the type system offers
// that cannot cross a boundary -- numbers, identifiers, strings, fixed-size shapes. It
// references no other namespace.
namespace Core {b1d0f2a4-3c17-4e6a-9f05-2a7c81d94e30} {

"""What things are attached to."""
concept Thing;

"""A derived concept in the same namespace: the easy case of inheritance."""
concept SubThing is a Thing;

concept Other;

"""A club whose members live here."""
club Klub;
membership Klub SubThing;
membership Klub Other;

"""An enumeration that other namespaces reference."""
enum Grade {
  low ,
  high
};

"""Same name as Parts::Colour, a different type -- the re-export collision."""
struct Colour {
  uint8 r;
  uint8 g;
  uint8 b;
};

"""Every scalar shape of the language, in the namespace that references no other.
What cannot cross a boundary is covered here, once."""
struct Scalars {
  bool f_bool;

  uint8 f_uint8;
  uint16 f_uint16;
  uint32 f_uint32;
  uint64 f_uint64;

  int8 f_int8;
  int16 f_int16;
  int32 f_int32;
  int64 f_int64;

  float f_float;
  double f_double;

  blob_id f_blob_id;
  commit_id f_commit_id;
  uuid f_uuid;

  string f_string;
  blob f_blob;
  any f_any;

  vec<uint8,2> f_vec;
  mat<uint8,2,2> f_mat;
};

"""Default values, which are a separate code path."""
struct Defaults {
  uint8 f_uint8 = 8;
  float f_float = 42.419998;
  string f_string = "Forty Two";
  uuid f_uuid = {388bbc06-60de-4d97-b3ee-18916e7043d3};
  vec<uint8,2> f_vec = {2,3};
  Grade f_grade = .low;
  Colour f_colour = {1, 2, 3};
};

"""A single-field structure: the zero/one case the generator handles separately."""
struct Single {
  uint8 f_single;
};

attachment<Thing, Colour> colour;

"""A document that is itself an aggregate: its operations differ from an ordinary
document's, since elements can be added and removed without overwriting it."""
attachment<Thing, set<key<Thing>>> related;
attachment<Thing, map<key<Thing>, Colour>> palette;
attachment<Thing, xarray<Colour>> history;

"""An ordinary document with an aggregate field: the same operations, at a path
instead of the root."""
struct Bag {
  set<key<Thing>> members;
  map<key<Thing>, Colour> tints;
  xarray<Colour> trail;
};

attachment<Thing, Bag> bag;
attachment<Thing, Scalars> scalars;

}; // ns
