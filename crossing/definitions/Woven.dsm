// Every composite shape of the language, with its elements taken from two other
// namespaces -- each one twice, as a structure field and as an attachment document type,
// because those are two different code paths.
//
// `features/all.dsm` covers the shapes in a single namespace, and `namespaces` covers
// three kinds of types across namespaces. Here the two cross.
namespace Woven {f7a3c518-2e64-4b90-8d17-9c05b6e2f483} {

"""A concept whose parent lives elsewhere."""
concept Derived is a Core::Thing;

"""What this namespace's attachments are attached to."""
concept Knot;

"""A club whose members come from two suppliers and share the same name: the getter
cannot be `asThingKey` on both sides, and a function name cannot contain `::`. Core::Klub
does not show this case, since its members are local."""
club Weave;
membership Weave Core::Thing;
membership Weave Parts::Thing;

// ── composite shapes, as fields ──

"""Every container, with elements from both suppliers."""
struct Composites {
  tuple<Core::Colour, Parts::Colour> f_tuple;
  optional<key<Core::Thing>> f_optional;
  vector<Parts::Colour> f_vector;
  set<key<Core::Thing>> f_set;
  map<key<Core::Thing>, key<Parts::Thing>> f_map_keys;
  map<Core::Grade, Parts::Colour> f_map_enum;
  xarray<Core::Colour> f_xarray;
  variant<Core::Colour, Parts::Colour, string> f_variant;
};

"""The entities of both suppliers, bare, as fields."""
struct Entities {
  Core::Grade f_core_grade;
  Parts::Grade f_parts_grade;
  Core::Colour f_core_colour;
  Parts::Colour f_parts_colour;
  Core::Single f_single;
  key<Core::Thing> f_thing;
  key<Core::SubThing> f_sub_thing;
  key<Parts::Thing> f_other_thing;
  key<Core::Klub> f_klub;
  key<any_concept> f_any_concept;
};

"""A local structure containing local structures: the nesting stays local."""
struct Nested {
  Composites f_composites;
  Entities f_entities;
};

// ── the same shapes, as attachment documents ──

attachment<Knot, tuple<Core::Colour, Parts::Colour>> docTuple;
attachment<Knot, optional<key<Core::Thing>>> docOptional;
attachment<Knot, vector<Parts::Colour>> docVector;
attachment<Knot, set<key<Core::Thing>>> docSet;
attachment<Knot, map<key<Core::Thing>, key<Parts::Thing>>> docMapKeys;
attachment<Knot, map<Core::Grade, Parts::Colour>> docMapEnum;
attachment<Knot, xarray<Core::Colour>> docXArray;
attachment<Knot, variant<Core::Colour, Parts::Colour>> docVariant;

attachment<Knot, Core::Grade> docGrade;
attachment<Knot, Core::Colour> docColour;
attachment<Knot, Parts::Colour> docOtherColour;
attachment<Knot, key<Core::Thing>> docThingKey;
attachment<Knot, key<Core::Klub>> docKlubKey;
attachment<Knot, key<any_concept>> docAnyConceptKey;
attachment<Knot, Composites> docComposites;

// An attachment on a concept from another namespace, whose document comes from a
// third: all three corners at once.
attachment<Core::Thing, Parts::Colour> mark;
attachment<Parts::Thing, Core::Colour> mark;

}; // ns
