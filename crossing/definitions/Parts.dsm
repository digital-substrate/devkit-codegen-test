// The second supplier: the same names as Core, different types, and no dependency
// either. It exists so that Woven has two sides to bring together.
namespace Parts {c4e91b73-8a52-4d1f-b6c8-5e3f0a92d716} {

"""Same name as Core::Thing, nothing in common."""
concept Thing;

"""Same name as Core::Colour, in floating point."""
struct Colour {
  float r;
  float g;
  float b;
};

"""Same name as Core::Grade, different cases."""
enum Grade {
  soft ,
  hard
};

attachment<Thing, Colour> colour;

}; // ns
