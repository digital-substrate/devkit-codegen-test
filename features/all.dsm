namespace Demo {7fdd9ba9-b85e-4b33-a749-9b9615e43452}  {

"""This is the documentation for the concept A"""
concept ConceptA;
concept ConceptB;
concept ConceptC is a ConceptB;
"""A grandchild: its key widens to ConceptB as well as to ConceptC."""
concept ConceptE is a ConceptC;
concept ConceptD;

"""This is the documentation for the club Klub"""
club Klub;
membership Klub ConceptC;
membership Klub ConceptD;

"""This is the documentation for enumeration E"""
enum EnumerationE {
  """This is the documentation for the enumeration case .a"""
  a ,
  b ,
  c 
};

"""This is the documentation for the struct S"""
struct StructureS {
  """This is the documentation for the field f_float"""
  float f_float;
  string f_string;
};

struct StructureT {
  string field_string;
  StructureS field_structure_s;
};

"""A field named as the generated class's own accessor to its runtime value."""
struct StructureValueField {
  int64 value;
  StructureS nested;
};

struct StructureU {
  // Numbers
  bool f_bool;

  uint8 f_uint8;
  uint16 f_uint16;
  uint32 f_uint32;
  uint64 f_uint64;

  int8 f_int8;
  int16 f_int16;
  int32 f_int32;
  int64 f_int64;

  float f_float;
  double f_double;

  // Ids
  blob_id f_blob_id;
  commit_id f_commit_id;
  uuid f_uuid;

  // String & Blob
  string f_string;
  blob f_blob;

  // Vec & Mat
  vec<uint8,2> f_vec;
  mat<uint8,2,2> f_mat;

  // Collections
  tuple<uint8, string> f_tuple;
  optional<uint8> f_optional;
  vector<uint8> f_vector;
  set<uint8> f_set;
  set<StructureS> f_set_s;
  map<StructureS, string> f_map_s1;
  map<string, StructureS> f_map_s2;
  xarray<uint8> f_xarray;
  xarray<StructureS> f_xarray_s;
  map<vector<StructureS>,string> f_map_vs;
  variant<string, uint8, StructureS> f_variant;
  
  // Any
  any f_any;

  EnumerationE f_E;
  StructureS f_S;
  StructureT f_T;

  key<ConceptA> f_A;
  key<ConceptB> f_B;
  key<ConceptC> f_C;
  key<ConceptD> f_D;
  key<Klub> f_Klub;
  
  // AnyConcept
  key<any_concept> f_any_concept;
};

struct StructureV {
  bool f_bool = true;

  uint8 f_uint8 = 8;
  uint16 f_uint16 = 16;
  uint32 f_uint32 = 32;
  uint64 f_uint64 = 64;

  int8 f_int8 = -8;
  int16 f_int16 = -16;
  int32 f_int32 = -32;
  int64 f_int64 = -64;

  float f_float = 42.419998;
  double f_double = 84.840000;

  uuid f_uuid = {388bbc06-60de-4d97-b3ee-18916e7043d3};
  string f_string = "Forty Two";

  vec<uint8,2> f_vec = {2,3};
  mat<uint8,2,3> f_mat = {{1, 2, 3}, {4, 5, 6}};

  tuple<uint8, string> f_tuple = {0, "1"};
  optional<uint8> f_optional = 8;
  vector<uint8> f_vector = {1, 2, 3};
  set<uint8> f_set = {1, 2, 3};
  map<uint8, string> f_map = {{0, "Zero"}, {1, "One"}};

  EnumerationE f_E = .a;
  StructureS f_S = {1.000000, ""};
  StructureT f_T = {"R", {0.000000, "essa"}};
};

attachment<ConceptA, StructureV> properties;
attachment<ConceptA, int8> propertiesInt8;
attachment<ConceptA, set<int8>> propertiesSeInt8;
attachment<ConceptA, map<int8, string>> propertiesMapInt8String;
attachment<ConceptA, xarray<int8>> propertiesXArray;

attachment<ConceptB, StructureT> propertiesB;
attachment<ConceptC, StructureU> propertiesC;

// We can't a key for this types in CDBE
attachment<Klub, StructureV> propertiesD;
attachment<any_concept, any> propertiesAnyConceptAny;

// Generation coverage.
//
// Every shape of the language must appear both as a structure field and as an
// attachment document type. The two are not the same code path: a field is
// written through its own accessor, while a document is fuzzed, decoded and
// brace-initialised, and the templates branch on the document type
// (isStructure, isNotBox, isSet, isMap, isXArray). StructureU and StructureV
// above cover the field side exhaustively; the attachments below cover the
// document side.

concept ConceptCoverage;

// A concept named like its namespace -- `Graph` in `Graph`, as real models do. From inside
// its attachments' scope, `Demo::X` would name the concept, not the namespace.
concept Demo;
attachment<Demo, StructureS> docNamedLikeItsNamespace;

// A club with no member, and a structure with a single field: both are shapes
// whose zero/one case the generator handles separately.
club EmptyKlub;

struct StructureW {
  uint8 f_single;
};

// A variant whose alternatives are keys: each is told, read and written by its own name.
struct StructureVariantKeys {
  variant<key<ConceptA>, key<ConceptD>> f_target;
};

// Floating-point values in every shape a field takes: NaN, the infinities and the two zeros
// are where equality, order and hash must hold as they do for any other datum.
struct StructureNumbers {
  double f_double;
  float f_float;
  vec<double, 3> f_vec;
  mat<float, 2, 2> f_mat;
  optional<double> f_optional;
  vector<double> f_vector;
  tuple<double, int32> f_tuple;
  variant<string, double> f_variant;
  map<string, double> f_map;
  xarray<double> f_xarray;
  StructureS f_S;
  set<double> f_set;
  map<vec<float, 2>, int32> f_map_by_vec;
};

// Numbers
attachment<ConceptCoverage, bool> docBool;
attachment<ConceptCoverage, uint8> docUInt8;
attachment<ConceptCoverage, uint16> docUInt16;
attachment<ConceptCoverage, uint32> docUInt32;
attachment<ConceptCoverage, uint64> docUInt64;
attachment<ConceptCoverage, int8> docInt8;
attachment<ConceptCoverage, int16> docInt16;
attachment<ConceptCoverage, int32> docInt32;
attachment<ConceptCoverage, int64> docInt64;
attachment<ConceptCoverage, float> docFloat;
attachment<ConceptCoverage, double> docDouble;
attachment<ConceptCoverage, map<double, int32>> docMapByDouble;

// Ids
attachment<ConceptCoverage, blob_id> docBlobId;
attachment<ConceptCoverage, commit_id> docCommitId;
attachment<ConceptCoverage, uuid> docUUId;

// String & Blob
attachment<ConceptCoverage, string> docString;
attachment<ConceptCoverage, blob> docBlob;

// Any
attachment<ConceptCoverage, any> docAny;

// Vec & Mat
attachment<ConceptCoverage, vec<uint8,2>> docVec;
attachment<ConceptCoverage, mat<uint8,2,2>> docMat;
// Non-square and inside a container: its type comes from the C++ shape, not from the
// definitions, so a column/row inversion shows up here -- a 2x2 would hide it.
attachment<ConceptCoverage, vector<mat<uint8,2,3>>> docVectorMat;

// Containers
attachment<ConceptCoverage, tuple<uint8, string>> docTuple;

"""A tuple whose members are all of one type: its getters return that type."""
attachment<ConceptCoverage, tuple<float, float>> docPair;
attachment<ConceptCoverage, optional<uint8>> docOptional;
attachment<ConceptCoverage, vector<uint8>> docVector;
attachment<ConceptCoverage, set<uint8>> docSet;
attachment<ConceptCoverage, map<uint8, string>> docMap;
attachment<ConceptCoverage, xarray<uint8>> docXArray;
attachment<ConceptCoverage, variant<string, uint8>> docVariant;

// Entities
attachment<ConceptCoverage, EnumerationE> docEnumeration;
attachment<ConceptCoverage, key<ConceptA>> docConceptKey;
attachment<ConceptCoverage, key<ConceptB>> docConceptKeyB;
attachment<ConceptCoverage, key<Klub>> docClubKey;
attachment<ConceptCoverage, key<any_concept>> docAnyConceptKey;
attachment<ConceptCoverage, StructureW> docStructureSingleField;

}; // ns


