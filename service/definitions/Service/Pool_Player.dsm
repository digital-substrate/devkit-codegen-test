namespace Demo {2eed02f5-5047-4d6f-9a4a-0888c21b31b0} {

enum Level {
    beginner,
    intermediate,
    expert
};

struct PlayerProperty {
    string nickname;
    Level level;
};

concept Player;

attachment<Player, PlayerProperty> property;

}; // ns


"""This pool provides access to the Player utility functions."""
attachment_function_pool PlayerModel {d75a8a57-f0ad-4a44-84f7-1ea409d4bd36} {
    mutable key<Player> create(string nickname, Level level);
    optional<key<Player>> hasPlayer(string nickname);
};
