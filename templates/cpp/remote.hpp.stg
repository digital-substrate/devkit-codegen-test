// Un pool, vu d'un client.
//
// LE CÔTÉ CLIENT EST UNE FEATURE À PART, ET CE N'EST PAS DU RANGEMENT. Dans un seul fichier,
// un client qui ne veut qu'appeler recevait aussi `pool()`, qui référence les fonctions que
// seul un serveur implémente : le lieur les réclamait. Séparés, un client ne lie que ceci, et
// un projet qui n'expose pas ses pools en service ne génère pas ce fichier du tout.

pool(p) ::= <<
<preamble(p, "")>

namespace <p.model.namespace>::<p.name;format="lsc"> {

<remote(p)>

} // namespace <p.model.namespace>::<p.name;format="lsc">

#endif
>>

attachment_pool(p) ::= <<
<preamble(p, "yes")>

namespace <p.model.namespace>::<p.name;format="lsc"> {

<attachment_remote(p)>

} // namespace <p.model.namespace>::<p.name;format="lsc">

#endif
>>

preamble(p, context) ::= <<
// <p.name> -- the same pool, seen from a client.
//
// Generated by kibo from <p.model.namespace>. Do not edit by hand.
// Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
// Runtime: this file links against the `viper` C++ runtime 1.2.x,
// distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
// Commercial use requires a Commercial Licence from Digital Substrate.
// <p.model.generated>

#ifndef <p.guard.remote>
#define <p.guard.remote>

<p.dependencies.functions:{d|#include "<d.include.data>"};separator="\n">

#include "Viper_ServiceRemote.hpp"
#include "Viper_Any.hpp"
#include "Viper_Blob.hpp"
#include "Viper_BlobId.hpp"
#include "Viper_CommitId.hpp"
#include "Viper_UUId.hpp"
#include "Viper_XArray.hpp"
<if(context)>

#include "Viper_AttachmentMutating.hpp"
<endif>

#include \<cstdint>
#include \<memory>
>>

remote(f) ::= <<
/// The same pool, seen from a client.
class Remote final {
public:
    explicit Remote(std::shared_ptr\<Viper::ServiceRemote> service);
    bool isAvailable() const;

<f.functions:remote_call();separator="\n">

private:
    std::shared_ptr\<Viper::ServiceRemote> _service;
};
>>

remote_call(f) ::= <<
<doc(f)>    <ret(f)> <f.name>(<f.parameters:param();separator=", ">) const;
>>

doc(f) ::= <<
<if(f.hasDocumentation)>    /** <f.documentation;format="comment"> */
<endif>
>>
ret(f) ::= <%<if(f.isVoid)>void<else><f.type><endif>%>
param(p) ::= <%<p.type><p.passBy> <p.name>%>


// LE REMOTE D'UN POOL D'ATTACHMENTS PORTE L'ÉTAT, PAS SEULEMENT LES ARGUMENTS. Un appel
// local agit sur l'interface qu'on lui donne ; à distance, cette interface est de ce
// côté-ci du fil, donc l'appel emporte ses changements avec lui et rapporte ceux du
// serveur. C'est pourquoi le contexte reste le premier paramètre -- et pourquoi c'est
// toujours `AttachmentMutating`, même pour une fonction qui ne fait que lire : le runtime
// n'a qu'une façon d'emporter un état, et elle est mutable.
attachment_remote(f) ::= <<
/// The same pool, seen from a client.
class Remote final {
public:
    explicit Remote(std::shared_ptr\<Viper::ServiceRemote> service);
    bool isAvailable() const;

<f.functions:attachment_remote_call();separator="\n">

private:
    std::shared_ptr\<Viper::ServiceRemote> _service;
};
>>

attachment_remote_call(f) ::= <<
<doc(f)>    <ret(f)> <f.name>(std::shared_ptr\<Viper::AttachmentMutating> const & attachmentMutating<if(f.parameters)>, <f.parameters:param();separator=", "><endif>) const;
>>
