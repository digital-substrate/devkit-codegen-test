// L'implémentation du pont d'une unité : trois fonctions par type, et rien d'autre.
//
// Le pack émet par unité sept artefacts de sérialisation, chacun avec une fonction par
// type. Tout ce qu'ils font est une composition générique de `write`, `read` et `type`,
// écrite une fois dans le module injecté ou dans le runtime -- ce qui laisse ici, par
// unité, trois fonctions par type déclaré.
//
// Et aucune ne nomme son unité : c'est l'argument, ou le tag, qui décide où aller. C'est
// ce qui remplace le suffixe de type, lequel disait dans un nom ce que la résolution de
// surcharge sait déjà.

unit(u) ::= <<
// <u.name> codec -- the `write`, `read` and `type` of each type declared here.
//
// Generated by kibo from <u.model.namespace>. Do not edit by hand.
// Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
// Runtime: this file links against the `viper` C++ runtime 1.2.x,
// distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
// Commercial use requires a Commercial Licence from Digital Substrate.
// <u.model.generated>

#include "<u.include.Codec>"

#include "<u.include.Model>"

#include "<u.model.include.Codec>"

#include "Viper_Definitions.hpp"
#include "Viper_StreamCodecInstancing.hpp"
#include "Viper_ValueDecoder.hpp"
#include "Viper_ValueEncoder.hpp"
#include "Viper_TypeErrors.hpp"
#include "Viper_Types.hpp"

namespace <u.model.namespace>::<u.name;format="lsc"> {


<u.concepts:keyed(u);separator="\n\n">

<u.clubs:keyed(u);separator="\n\n">

<u.enumerations:enumeration(u);separator="\n\n">

<u.structures:structure(u);separator="\n\n">

} // namespace <u.model.namespace>::<u.name;format="lsc">
>>





// Une clé, sur le fil, c'est deux uuid : l'instance, et le concept qu'elle est réellement.
// Le second est stocké et non déduit du type, parce qu'une clé peut nommer une instance
// d'un concept dérivé, et c'est l'identité de celui-là qui doit traverser.
keyed(c, u) ::= <<
void write(Viper::StaticWriter::Writer & w, <c.name>Key const & value) {
    write(w, value.instanceId());
    write(w, value.runtimeId());
}

<keyed_read_head(c)>
    auto const instanceId{read(r, Viper::StaticType::tag\<Viper::UUId>{})};
    auto const runtimeId{read(r, Viper::StaticType::tag\<Viper::UUId>{})};

    return {instanceId, runtimeId};
}

>>

keyed_read_head(c) ::= <%<c.name>Key read(Viper::StaticReader::Reader & r, Viper::StaticType::tag\<<c.name>Key>) {%>

// CE QUI TRAVERSE EST L'INDEX DE LA CASE, PAS SA VALEUR. Le modèle ordonne les cases et
// c'est cet ordre qui est le contrat ; une valeur C++ explicite ferait dire au langage ce
// que le modèle dit déjà, et les deux pourraient diverger.
enumeration(e, u) ::= <<
void write(Viper::StaticWriter::Writer & w, <e.name> value) {
    switch (value) {
<e.members:{m|<m:enumeration_write(e, i0)>};separator="\n">
        default:
            throw Viper::TypeErrors::invalidEnumerationIndex(
                "<u.name>", "<e.name>", __FUNCTION__, static_cast\<std::uint8_t>(value));
    }
}

<plain_read_head(e)>
    switch (auto const index{r.streamReading->readUInt8()}) {
<e.members:{m|<m:enumeration_read(e, i0)>};separator="\n">
        default:
            throw Viper::TypeErrors::invalidEnumerationIndex("<u.name>", "<e.name>", __FUNCTION__, index);
    }
}

>>

// `i0` n'existe que dans une sous-template anonyme, d'où le passage explicite ci-dessus :
// un template nommé ne le voit pas, et StringTemplate le dit -- tardivement.
enumeration_write(m, e, i) ::= <<
        case <e.name>::<m.name;format="uf">: w.streamWriting->writeUInt8(<i>); break;
>>

enumeration_read(m, e, i) ::= <<
        case <i>: return <e.name>::<m.name;format="uf">;
>>

// Une structure, c'est ses champs dans l'ordre, chacun confié à l'unité qui le possède --
// `write(w, value.x)` part chez le runtime pour un entier et chez une autre unité pour une
// clé étrangère, sans que rien ici ait à le savoir.
structure(s, u) ::= <<
void write(Viper::StaticWriter::Writer & w, <s.name> const & value) {
<s.fields:field_write();separator="\n">
}

<plain_read_head(s)>
    return {<s.fields:field_read();separator=",\n            ">};
}

>>

field_write(f) ::= <<    write(w, value.<f.name>);>>

// PAS DE VARIABLE LOCALE PAR CHAMP, et ce n'est pas un raccourci. Nommer le local d'après
// le champ -- ce que fait le pack, où le lecteur est `this` -- devient faux ici : le
// lecteur est un paramètre, donc un champ nommé `r` produit `auto const r{read(r, …)}`,
// qui lit sa propre variable non initialisée. Une liste d'initialisation entre accolades
// évalue ses éléments de gauche à droite, garanti par le langage, donc l'ordre du modèle
// est respecté sans nommer quoi que ce soit.
field_read(f) ::= <%read(r, Viper::StaticType::tag\<<f.typeInNamespace>>{})%>

plain_read_head(e) ::= <%<e.name> read(Viper::StaticReader::Reader & r, Viper::StaticType::tag\<<e.name>>) {%>

// ── et le socle ──
// LES DEUX SEULS MEMBRES DE L'AnyConceptKey GÉNÉRÉE QUI AVAIENT BESOIN DU MODÈLE, et la
// question qu'ils posent : quelqu'un doit bien fournir l'ensemble des concepts connus.
//
// Quelqu'un le fait déjà. Le modèle enregistre chacun de ses concepts dans ses
// `Definitions` au chargement -- c'est l'artefact d'enregistrement, qui existe de toute
// façon, sans quoi rien du runtime ne fonctionnerait. Demander à cet enregistrement
// revient à ne rien générer de plus.
//
// ET C'EST LA BONNE RÉPONSE, PAS SEULEMENT LA PLUS COURTE. Le pack fige la liste à la
// génération : `isKnown()` compare l'identifiant à un ensemble clos au moment où le code a
// été écrit. Or `Viper::Definitions::extendConcepts` existe -- un modèle apprend des
// concepts en cours d'exécution, d'un pair ou d'un document plus récent. Une liste figée
// répond alors « inconnu » pour un concept que le runtime connaît, et le pack le reconnaît
// lui-même dans un commentaire sur `description`.
//
// Interroger le modèle donne la réponse d'aujourd'hui ; l'énumérer donne celle du jour de
// la génération.
//
// LE MODÈLE EST UNE DONNÉE, PAS DU CODE. Rien n'enregistre les types un par un : le `.dsm`
// est embarqué tel quel et décodé au premier appel. C'est ce qui rend le socle petit --
// il n'y a pas d'artefact d'enregistrement à générer par unité -- et c'est aussi ce qui
// répond à « qui tient la liste des concepts connus » : cette liste-là.
model(m) ::= <<
// <m.namespace>::codec -- the embedded definitions, the bridge's stream codec, and what an
// untyped key names.
//
// Generated by kibo from <m.namespace>. Do not edit by hand.
// Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
// Runtime: this file links against the `viper` C++ runtime 1.2.x,
// distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
// Commercial use requires a Commercial Licence from Digital Substrate.
// <m.generated>

#include "<m.include.Codec>"

#include "<m.include.Resources>"      // the definitions, as bytes

#include "Viper_Definitions.hpp"
#include "Viper_StreamRawCodec.hpp"
#include "Viper_StreamTokenBinaryCodec.hpp"
#include "Viper_TypeClub.hpp"
#include "Viper_TypeConcept.hpp"
#include "Viper_DefinitionsDecoder.hpp"
#include "Viper_Types.hpp"

#include \<cstring>

namespace <m.namespace>::codec {

std::shared_ptr\<Viper::Definitions const> const & definitions() {
    static std::shared_ptr\<Viper::Definitions const> instance;
    if (!instance) {
        Viper::Blob blob(sizeof(::<m.namespace>_resources_definitions));
        std::memcpy(blob.storage.data(), ::<m.namespace>_resources_definitions, blob.size());
        instance = Viper::DefinitionsDecoder::decode(blob, Viper::StreamTokenBinaryCodec::Instance());
    }
    return instance;
}

/// The bridge's codec. `StreamRaw` keeps the layout without the byte-order handling a
/// portable format needs: nothing the bridge writes leaves the process.
std::shared_ptr\<Viper::StreamCodecInstancing> const & stream() {
    static std::shared_ptr\<Viper::StreamCodecInstancing> const instance{
        Viper::StreamRawCodec::Instance()};
    return instance;
}

bool isKnown(AnyConceptKey const & key,
             std::shared_ptr\<Viper::Definitions const> const & definitions) {
    return definitions->queryConcept(key.runtimeId()) != nullptr;
}

std::string description(AnyConceptKey const & key,
                        std::shared_ptr\<Viper::Definitions const> const & definitions) {
    auto const concept_ = definitions->queryConcept(key.runtimeId());
    if (!concept_)
        return key.instanceId().uuidString() + ":?(" + key.runtimeId().uuidString() + ")";

    return key.instanceId().uuidString() + ":" + concept_->representation();
}

/// Whether `key` names an instance of `concept_`: a concept derived from it or, for a
/// club, one of its members -- the descriptor carries the difference.
bool isMember(AnyConceptKey const & key, std::shared_ptr\<Viper::Type> const & concept_,
              std::shared_ptr\<Viper::Definitions const> const & definitions) {
    auto const instance = definitions->queryConcept(key.runtimeId());
    if (!instance)
        return false;                                  // a concept these definitions do not know

    if (auto const target = std::dynamic_pointer_cast\<Viper::TypeConcept>(concept_))
        return instance->isMember(target);

    if (auto const club = std::dynamic_pointer_cast\<Viper::TypeClub>(concept_))
        return club->isMemberDescendant(instance);

    return false;
}

} // namespace <m.namespace>::codec

>>
