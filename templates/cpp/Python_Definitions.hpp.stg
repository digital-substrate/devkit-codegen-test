// POUR LE PYTHON EMBARQUÉ DANS UNE APPLICATION C++. Les scripts qui manipulent le modèle par
// l'API dynamique de dsviper y trouvent ses types, ses attachments et ses chemins de champ
// sous des noms constants -- `GRAPH_A_EDGE_TOPOLOGY` plutôt qu'un identifiant écrit à la
// main --, le pendant de Fields pour ce monde-là. Les noms sont ceux du pack 1.2, pour que les
// scripts existants ne changent pas.
model(m) ::= <<
// <m.namespace> Python definitions -- the model's types, attachments and field paths as
// constants of an embedded Python module, for scripts using the dynamic API.
//
// Generated by kibo from <m.namespace>. Do not edit by hand.
// Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
// Runtime: this file links against the `viper` C++ runtime 1.2.x,
// distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
// Commercial use requires a Commercial Licence from Digital Substrate.
// <m.generated>

#ifndef <m.namespace>_Python_Definitions_hpp
#define <m.namespace>_Python_Definitions_hpp

#define PY_SSIZE_T_CLEAN
#include \<Python.h>

namespace <m.namespace;format="lsc">::python_definitions {

/// Add every constant to `module`.
void fill(PyObject * module);

} // namespace <m.namespace;format="lsc">::python_definitions

#endif

>>
