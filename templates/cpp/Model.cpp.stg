// Les identifiants et les descripteurs de l'unité, résolus contre le modèle.
//
// Chaque descripteur est résolu une fois : les Definitions du modèle sont enregistrées au
// chargement, donc la réponse ne change pas d'un appel à l'autre.

unit(u) ::= <<
// unité <u.name> — son identité dans le modèle.
//
// Generated by kibo from <u.model.namespace>. Do not edit by hand.
// Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
// Runtime: this file links against the `viper` C++ runtime 1.2.x,
// distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
// Commercial use requires a Commercial Licence from Digital Substrate.
// <u.model.generated>

#include "<u.include.Model>"

#include "<u.model.include.Codec>"

#include "Viper_Definitions.hpp"

namespace <u.name> {

namespace RuntimeIds {
<u.concepts:runtime_id();separator="\n">
<u.clubs:runtime_id();separator="\n">
<u.enumerations:runtime_id();separator="\n">
<u.structures:runtime_id();separator="\n">
} // namespace RuntimeIds

<u.concepts:concept_type(u);separator="\n\n">

<u.clubs:club_type(u);separator="\n\n">

<u.concepts:concept_key_type(u);separator="\n\n">

<u.clubs:club_key_type(u);separator="\n\n">

<u.enumerations:enumeration_type(u);separator="\n\n">

<u.structures:structure_type(u);separator="\n\n">

} // namespace <u.name>
>>

runtime_id(e) ::= <%Viper::UUId const <e.name>{Viper::UUId::parse("<e.runtimeId>")};%>

concept_type(c, u) ::= <<
<concept_type_head(c)>
    static std::shared_ptr\<Viper::Type> const instance{
        <u.model.namespace>::Codec::definitions()->checkConcept(RuntimeIds::<c.name>)};
    return instance;
}
>>

club_type(c, u) ::= <<
<club_type_head(c)>
    static std::shared_ptr\<Viper::Type> const instance{
        <u.model.namespace>::Codec::definitions()->checkClub(RuntimeIds::<c.name>)};
    return instance;
}
>>

// La clé d'un concept est un type dérivé du concept, que le runtime fabrique -- et celle
// d'un club se fabrique pareil, à partir du descripteur du club.
concept_key_type(c, u) ::= <<
<keyed_type_head(c)>
    static std::shared_ptr\<Viper::Type> const instance{Viper::TypeKey::make(conceptType(Viper::Codec::tag\<<c.name>Key>{}))};
    return instance;
}
>>

club_key_type(c, u) ::= <<
<keyed_type_head(c)>
    static std::shared_ptr\<Viper::Type> const instance{Viper::TypeKey::make(clubType(Viper::Codec::tag\<<c.name>Key>{}))};
    return instance;
}
>>

enumeration_type(e, u) ::= <<
<plain_type_head(e)>
    static std::shared_ptr\<Viper::Type> const instance{
        <u.model.namespace>::Codec::definitions()->checkEnumeration(RuntimeIds::<e.name>)};
    return instance;
}
>>

structure_type(s, u) ::= <<
<plain_type_head(s)>
    static std::shared_ptr\<Viper::Type> const instance{
        <u.model.namespace>::Codec::definitions()->checkStructure(RuntimeIds::<s.name>)};
    return instance;
}
>>

concept_type_head(c) ::= <%std::shared_ptr\<Viper::Type> const & conceptType(Viper::Codec::tag\<<c.name>Key>) {%>
club_type_head(c) ::= <%std::shared_ptr\<Viper::Type> const & clubType(Viper::Codec::tag\<<c.name>Key>) {%>
keyed_type_head(e) ::= <%std::shared_ptr\<Viper::Type> const & type(Viper::Codec::tag\<<e.name>Key>) {%>
plain_type_head(e) ::= <%std::shared_ptr\<Viper::Type> const & type(Viper::Codec::tag\<<e.name>>) {%>
