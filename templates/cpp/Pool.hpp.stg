// A pool is a unit: it holds only functions, nothing depends on it, and its name is
// already a scope. The local side and the remote side of one pool live together, because
// they are the same operation in process and across a wire.

pool(p) ::= <<
<preamble(p, "FunctionPool", "")>

namespace <p.name;format="uf"> {

<p.functions:bridge();separator="\n">

std::shared_ptr\<Viper::FunctionPool> pool();

<remote(p)>

} // namespace <p.name;format="uf">

#endif
>>

attachment_pool(p) ::= <<
<preamble(p, "AttachmentFunctionPool", "yes")>

namespace <p.name;format="uf"> {

<p.functions:attachment_bridge();separator="\n">

std::shared_ptr\<Viper::AttachmentFunctionPool> pool();

<attachment_remote(p)>

} // namespace <p.name;format="uf">

#endif
>>

preamble(p, kind, context) ::= <<
// <p.name> — a pool, and a unit in its own right.
//
// Generated by kibo from <p.model.namespace>. Do not edit by hand.
// Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
// Runtime: this file links against the `viper` C++ runtime 1.2.x,
// distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
// Commercial use requires a Commercial Licence from Digital Substrate.
// <p.model.generated>

#ifndef <p.name>_Pool_hpp
#define <p.name>_Pool_hpp

<p.dependencies.functions:{d|#include "<d.include.Data>"};separator="\n">

#include "Viper_<kind>.hpp"
#include "Viper_ServiceRemote.hpp"
<if(context)>

// LE CONTEXTE SUR LEQUEL LA FONCTION AGIT. Un pool ordinaire n'en prend pas ; celui-ci le
// prend en premier argument, donc il en a besoin dans ses signatures.
#include "Viper_AttachmentGetting.hpp"
#include "Viper_AttachmentMutating.hpp"
<endif>

#include \<cstdint>
#include \<memory>
>>

bridge(f) ::= <%<ret(f)> <f.name;format="lsc">(<f.parameters:param();separator=", ">);%>

// UNE FONCTION DE POOL D'ATTACHMENTS PREND L'INTERFACE SUR LAQUELLE AGIR. Elle opère sur
// des documents et non sur des valeurs seules, donc le contexte est un paramètre -- et il
// est le premier, comme le Writer l'est pour `write`, pour la même raison : c'est lui qui
// dit à quoi l'appel s'applique.
attachment_bridge(f) ::= <%<ret(f)> <f.name;format="lsc">(std::shared_ptr\<Viper::Attachment<f.interfaceType>> const & attachment<f.interfaceType><if(f.parameters)>, <f.parameters:param();separator=", "><endif>);%>

remote(f) ::= <<
/// The same pool, seen from a client.
class Remote final {
public:
    explicit Remote(std::shared_ptr\<Viper::ServiceRemote> service);
    bool isAvailable() const;

<f.functions:remote_call();separator="\n">

private:
    std::shared_ptr\<Viper::ServiceRemote> _service;
};
>>

remote_call(f) ::= <<    <ret(f)> <f.name;format="lsc">(<f.parameters:param();separator=", ">) const;>>
ret(f) ::= <%<if(f.isVoid)>void<else><f.type><endif>%>
param(p) ::= <%<p.type><p.passBy> <p.name>%>


// LE REMOTE D'UN POOL D'ATTACHMENTS PORTE L'ÉTAT, PAS SEULEMENT LES ARGUMENTS. Un appel
// local agit sur l'interface qu'on lui donne ; à distance, cette interface est de ce
// côté-ci du fil, donc l'appel emporte ses changements avec lui et rapporte ceux du
// serveur. C'est pourquoi le contexte reste le premier paramètre -- et pourquoi c'est
// toujours `AttachmentMutating`, même pour une fonction qui ne fait que lire : le runtime
// n'a qu'une façon d'emporter un état, et elle est mutable.
attachment_remote(f) ::= <<
/// The same pool, seen from a client.
class Remote final {
public:
    explicit Remote(std::shared_ptr\<Viper::ServiceRemote> service);
    bool isAvailable() const;

<f.functions:attachment_remote_call();separator="\n">

private:
    std::shared_ptr\<Viper::ServiceRemote> _service;
};
>>

attachment_remote_call(f) ::= <<    <ret(f)> <f.name;format="lsc">(std::shared_ptr\<Viper::AttachmentMutating> const & attachmentMutating<if(f.parameters)>, <f.parameters:param();separator=", "><endif>) const;>>
