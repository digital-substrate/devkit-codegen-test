// A pool is a unit: it holds only functions, nothing depends on it, and its name is
// already a scope. This is its server side -- what the application implements and
// registers; the client side is `Remote`, a feature of its own.

pool(p) ::= <<
<preamble(p, "FunctionPool", "")>

namespace <p.model.namespace>::<p.name;format="lsc"> {

<p.functions:bridge();separator="\n">

std::shared_ptr\<Viper::FunctionPool> pool();


} // namespace <p.model.namespace>::<p.name;format="lsc">

#endif
>>

attachment_pool(p) ::= <<
<preamble(p, "AttachmentFunctionPool", "yes")>

namespace <p.model.namespace>::<p.name;format="lsc"> {

<p.functions:attachment_bridge();separator="\n">

std::shared_ptr\<Viper::AttachmentFunctionPool> pool();


} // namespace <p.model.namespace>::<p.name;format="lsc">

#endif
>>

// LE CONTEXTE SUR LEQUEL LA FONCTION AGIT. Un pool ordinaire n'en prend pas ; celui-ci le
// prend en premier argument, donc il en a besoin dans ses signatures.
preamble(p, kind, context) ::= <<
// <p.name> -- a function pool: the functions the application implements, and the pool.
//
// Generated by kibo from <p.model.namespace>. Do not edit by hand.
// Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
// Runtime: this file links against the `viper` C++ runtime 1.2.x,
// distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
// Commercial use requires a Commercial Licence from Digital Substrate.
// <p.model.generated>

#ifndef <p.guard.Pool>
#define <p.guard.Pool>

<p.dependencies.functions:{d|#include "<d.include.Data>"};separator="\n">

#include "Viper_<kind>.hpp"
#include "Viper_Any.hpp"
#include "Viper_Blob.hpp"
#include "Viper_BlobId.hpp"
#include "Viper_CommitId.hpp"
#include "Viper_UUId.hpp"
#include "Viper_XArray.hpp"
<if(context)>

#include "Viper_AttachmentGetting.hpp"
#include "Viper_AttachmentMutating.hpp"
<endif>

#include \<cstdint>
#include \<memory>
>>

bridge(f) ::= <%<ret(f)> <f.name>(<f.parameters:param();separator=", ">);%>

// UNE FONCTION DE POOL D'ATTACHMENTS PREND L'INTERFACE SUR LAQUELLE AGIR. Elle opère sur
// des documents et non sur des valeurs seules, donc le contexte est un paramètre -- et il
// est le premier, comme le Writer l'est pour `write`, pour la même raison : c'est lui qui
// dit à quoi l'appel s'applique.
attachment_bridge(f) ::= <%<ret(f)> <f.name>(std::shared_ptr\<Viper::Attachment<f.interfaceType>> const & attachment<f.interfaceType><if(f.parameters)>, <f.parameters:param();separator=", "><endif>);%>

ret(f) ::= <%<if(f.isVoid)>void<else><f.type><endif>%>
param(p) ::= <%<p.type><p.passBy> <p.name>%>
