// `<%…%>` and not `<<…>>` for the two below: a `>>` in the emitted text closes a
// `<<…>>` body, so `tag<Colour>` cannot be written there. Writing `tag<Colour >` works
// and is valid C++, but it is a workaround leaking into the output.
// UNE ÉNUMÉRATION SE PASSE PAR VALEUR. Elle tient dans un registre, et surtout : la
// déclaration et la définition doivent s'accorder, sinon ce sont deux surcharges et
// l'appel devient ambigu au lieu d'être introuvable -- un diagnostic qui ne dit pas ce
// qui manque.
enumeration(e) ::= <<
void write(Viper::StaticWriter::Writer & w, <e.name> value);
<plain_read(e)>
>>

plain(e) ::= <<
void write(Viper::StaticWriter::Writer & w, <e.name> const & value);
<plain_read(e)>
>>

plain_read(e) ::= <%<e.name> read(Viper::StaticReader::Reader & r, Viper::StaticType::tag\<<e.name>>);%>

// ── et le socle, rendu une fois pour tout le modèle ──
//
// MÊME FICHIER, DEUX ENTRÉES. `unit(u)` sort une fois par namespace, `model(m)` une fois
// pour le modèle, et kibo rend les deux : c'est précisément pour cela que la discrimination
// se fait sur l'entrée déclarée. Le codec d'une unité et le socle qui le porte se lisent
// ensemble, ce qui est où un lecteur les cherche.
//
// QUATRE DÉCLARATIONS, ET LE CRITÈRE EST LE MÊME POUR LES QUATRE : elles ont besoin du
// modèle entier, donc aucun namespace ne peut en répondre. C'est tout ce que le socle est.
// ENCODE ET DECODE SONT GÉNÉRIQUES. Le pack écrit le même corps de dix lignes une fois par
// type, dont seul le suffixe change -- et ce qui change est exactement ce qu'une unité
// implémente : `write`/`read` pour la valeur, `type` pour son descripteur, trouvés par ADL
// sur l'argument ou sur le tag. Un template remplace toute la famille encode_X / decode_X.
//
// Les descripteurs des primitives et des conteneurs sont du runtime : le type d'une
// primitive est un singleton, celui d'un conteneur se compose à partir de ses éléments.
//
// LE BLOB DE decode EST NOMMÉ, ET IL LE DOIT : passer le résultat de l'encodage directement
// laisse mourir le temporaire à la fin de l'expression, et le décodeur lit dans le vide.
// ── ce que la clé non typée ne peut pas porter elle-même ──
//
// LES DEUX SEULS MEMBRES DE L'AnyConceptKey GÉNÉRÉE QUI AVAIENT BESOIN DU MODÈLE. Les sept
// autres sont deux uuid, leurs comparaisons et leur hachage. Fonctions libres, et non
// membres : un seul membre aurait obligé la classe entière à être générée -- ce qu'elle
// est aujourd'hui, pour ces deux lignes.

// L'ENSEMBLE DES CONCEPTS CONNUS EST UN ARGUMENT, ET C'EST TOUT L'INTÉRÊT DE CES TROIS
// FONCTIONS. Les poser sur `definitions()` -- les définitions du modèle, embarquées quand
// kibo a tourné -- reviendrait exactement à l'énumération que le pack écrit : le même
// ensemble, clos au même instant, interrogé autrement. Remplacer une liste par une requête
// sur cette liste ne gagne rien.
//
// L'ensemble s'ouvre ailleurs. `Database::open` charge les définitions du fichier et vérifie
// seulement qu'elles *contiennent* celles du modèle : ce que la base rend peut être
// strictement plus large -- écrit par une version plus récente, ou par un autre modèle
// partageant le fichier. Un pair en RPC est dans le même cas, et `extendConcepts` existe
// pour cela.
//
// Une clé qui vient de là peut nommer un concept que le modèle embarqué ignore, et la seule
// réponse utile est celle des définitions qu'on a en main.
model(m) ::= <<
// <m.namespace>::Codec -- what needs the whole model: its definitions, and the bridge
// between a C++ value and a Viper::Value.
//
// Generated by kibo from <m.namespace>. Do not edit by hand.
// Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
// Runtime: this file links against the `viper` C++ runtime 1.2.x,
// distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
// Commercial use requires a Commercial Licence from Digital Substrate.
// <m.generated>
//
//   definitions()      the model, as the runtime knows it
//   encode / decode    a C++ value to a Viper::Value, and back, for any generated type
//                      and any container of them
//   description, isKnown, isMember   what an untyped key names
//
// JSON, XML and hashing are the runtime's, applied to what `encode` returns.

#ifndef <m.namespace>_Codec_hpp
#define <m.namespace>_Codec_hpp

#include "<m.namespace>_AnyConcept.hpp"
#include "Viper_StaticWriter.hpp"
#include "Viper_StaticReader.hpp"
#include "Viper_Definitions.hpp"
#include "Viper_StreamCodecInstancing.hpp"
#include "Viper_StreamDecoding.hpp"
#include "Viper_StreamEncoding.hpp"
#include "Viper_ValueDecoder.hpp"
#include "Viper_ValueEncoder.hpp"
#include "Viper_Values.hpp"
#include "Viper_ValueSetIter.hpp"

#include \<memory>
#include \<string>

namespace <m.namespace>::Codec {

using Viper::StaticType::tag;

/// The model's definitions, decoded once from the embedded resource.
std::shared_ptr\<Viper::Definitions const> const & definitions();

/// The stream codec `encode` and `decode` cross through. Nothing it writes is persisted.
std::shared_ptr\<Viper::StreamCodecInstancing> const & stream();

/// `instanceId:Concept` as `definitions` name it, or the raw ids if they do not know it.
std::string description(AnyConceptKey const & key,
                        std::shared_ptr\<Viper::Definitions const> const & definitions);

/// Whether `definitions` know the concept `key` names.
bool isKnown(AnyConceptKey const & key,
             std::shared_ptr\<Viper::Definitions const> const & definitions);

/// Whether `key` names an instance of `concept_`, a concept derived from it, or -- when
/// `concept_` is a club -- one of its members.
bool isMember(AnyConceptKey const & key, std::shared_ptr\<Viper::Type> const & concept_,
              std::shared_ptr\<Viper::Definitions const> const & definitions);

/// The same against the embedded definitions. A key read from a database or a remote peer
/// may name a concept they do not know; pass the definitions it came with instead.
inline std::string description(AnyConceptKey const & key) { return description(key, definitions()); }
inline bool isKnown(AnyConceptKey const & key) { return isKnown(key, definitions()); }
inline bool isMember(AnyConceptKey const & key, std::shared_ptr\<Viper::Type> const & concept_) {
    return isMember(key, concept_, definitions());
}

/// A C++ value to a Viper::Value of the matching type.
template\<class T>
std::shared_ptr\<Viper::Value> encode(T const & value) {
    auto const encoder = stream()->createEncoder();
    Viper::StaticWriter::Writer writer{encoder};
    write(writer, value);

    return Viper::ValueDecoder::decode(encoder->endEncoding(), stream(),
                                       type(tag\<T>{}),
                                       definitions());
}

/// A Viper::Value back to a C++ value; the value must have the type of `T`.
template\<class T>
T decode(std::shared_ptr\<Viper::Value const> const & value) {
    // Named: `createDecoder` keeps a reference to the blob.
    auto const blob{Viper::ValueEncoder::encode(value, stream())};
    auto const decoder{stream()->createDecoder(blob)};
    Viper::StaticReader::Reader reader{decoder, definitions()};

    return read(reader, tag\<T>{});
}

} // namespace <m.namespace>::Codec

#endif

>>
