// L'adressage des champs d'une unité.
//
// Le chemin est construit à partir de la constante déclarée au-dessus de lui, et non d'un
// littéral recopié : le nom d'un champ n'apparaît qu'une fois dans toute l'unité. Le pack
// écrit `makeField("r")` dans un fichier et `std::string const r{"r"}` dans un autre, et
// rien ne garantit que les deux disent la même chose.
//
// Un chemin est une propriété de la structure, pas d'une valeur : un par champ pour la
// durée du programme, construit une fois et rendu par référence.

unit(u) ::= <<
// <u.name> fields -- the implementation of the field paths.
//
// Generated by kibo from <u.model.namespace>. Do not edit by hand.
// Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
// Runtime: this file links against the `viper` C++ runtime 1.2.x,
// distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
// Commercial use requires a Commercial Licence from Digital Substrate.
// <u.model.generated>

#include "<u.include.Fields>"

<u.structures:structure(u);separator="\n\n">
>>

structure(s, u) ::= <<
namespace <u.model.namespace>::<u.name;format="lsc">::fields::<s.name> {

<s.fields:path();separator="\n\n">

} // namespace <u.model.namespace>::<u.name;format="lsc">::fields::<s.name>
>>

path(f) ::= <<
std::shared_ptr\<Viper::Path const> const & <f.name>Path() {
    static std::shared_ptr\<Viper::Path const> const instance{Viper::Path::makeField(std::string{<f.name>})};
    return instance;
}
>>
