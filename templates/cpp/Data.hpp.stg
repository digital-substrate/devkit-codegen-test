unit(u) ::= <<
// unité <u.name> — les types qu'elle déclare.
//
// Generated by kibo from <u.model.namespace>. Do not edit by hand.
// Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
// Runtime: this file links against the `viper` C++ runtime 1.2.x,
// distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
// Commercial use requires a Commercial Licence from Digital Substrate.
// <u.model.generated>

#ifndef <u.name>_Data_hpp
#define <u.name>_Data_hpp

<u.dependencies.types:{d|#include "<d.include.Data>"};separator="\n">

#include "<u.model.include.AnyConcept>"

#include "Viper_HashAccumulator.hpp"
#include "Viper_Blob.hpp"
#include "Viper_UUId.hpp"

#include \<array>
#include \<cstdint>
#include \<map>
#include \<set>
#include \<string>
#include \<variant>
#include \<vector>
#include \<functional>
#include \<optional>

namespace <u.name> {

<u.concepts:concept();separator="\n\n">

<u.clubs:club(u);separator="\n\n">

<u.enumerations:enumeration();separator="\n\n">

<u.sortedStructures:structure();separator="\n\n">

} // namespace <u.name>

<u.concepts:std_hash(u);separator="\n">
<u.clubs:std_hash(u);separator="\n">
<u.sortedStructures:std_hash_value(u);separator="\n">

#endif
>>

concept(c) ::= <<
<if(c.documentation)>/** <c.documentation> */
<endif>class <c.name>Key final {
public:
    <c.name>Key() = default;
    <c.name>Key(Viper::UUId const & instanceId, Viper::UUId const & runtimeId) noexcept;

    /// Reconstruire une clé depuis l'identifiant d'instance seul : l'identifiant
    /// d'exécution est celui de ce concept-ci.
    ///
    /// EXPLICITE, LÀ OÙ LE PACK LAISSAIT LA CONVERSION IMPLICITE. Toutes les clés du modèle
    /// ont la même forme, donc une conversion implicite depuis `UUId` fait de n'importe quel
    /// identifiant n'importe quelle clé, en silence -- ce que le typage des clés existe
    /// justement pour empêcher. `<c.name>Key{id}` dit la même chose et la dit exprès.
    explicit <c.name>Key(Viper::UUId const & instanceId) noexcept;

    static <c.name>Key create();

    Viper::UUId const & instanceId() const noexcept;
    Viper::UUId const & runtimeId() const noexcept;

    /// Ce que la clé désigne, dit en clair, et si le modèle le connaît.
    ///
    /// LA RÉPONSE VIENT DES DÉFINITIONS, PAS DE LA GÉNÉRATION. Un identifiant d'exécution
    /// peut être celui d'un descendant qui n'existait pas quand ce fichier a été écrit ;
    /// les définitions embarquées, elles, sont lues à l'exécution et savent le nommer.
    std::string description() const;
    bool isKnown() const;

    bool isValid() const noexcept;
<if(c.dsmConcept.parent)>
    /// Élargir vers le parent. Implicite, parce que `is a` n'est pas une demande : partout
    /// où le parent est attendu, le dérivé passe.
    operator <c.parentNameInNamespace>Key() const noexcept;

    /// Et la même, nommée. DEUX FORMES DE LA MÊME CHOSE, ET LES DEUX SERVENT : l'implicite
    /// pour l'appelant qui passe la clé, la nommée pour celui qui la range ou l'écrit dans
    /// une expression où la conversion ne se déclencherait pas.
    <c.parentNameInNamespace>Key toParentKey() const noexcept;
<endif>
    <u.model.namespace>::AnyConceptKey toAny() const noexcept;
    static std::optional\<<c.name>Key> from(<u.model.namespace>::AnyConceptKey const & key) noexcept;


private:
    Viper::UUId _instanceId{};
    Viper::UUId _runtimeId{};
};

bool operator==(<c.name>Key const &, <c.name>Key const &) noexcept;
bool operator!=(<c.name>Key const &, <c.name>Key const &) noexcept;
bool operator\<(<c.name>Key const &, <c.name>Key const &) noexcept;

void hash(Viper::Hash::Accumulator & h, <c.name>Key const & value) noexcept;
>>

// UN CLUB EST UN ENSEMBLE NOMMÉ DE CONCEPTS, et sa clé peut désigner une instance de
// n'importe lequel. Les conversions sont du côté du club et non du membre : un club
// connaît ses membres, un membre n'a pas à connaître ses clubs -- et souvent il ne le peut
// pas, ses membres pouvant vivre dans des unités qui ignorent celle du club et dont elle
// dépend. Poser la conversion chez le membre inverserait l'arête du graphe.
club(c, u) ::= <<
<if(c.documentation)>/** <c.documentation> */
<endif>class <c.name>Key final {
public:
    <c.name>Key() = default;
    <c.name>Key(Viper::UUId const & instanceId, Viper::UUId const & runtimeId) noexcept;

    /// Reconstruire une clé depuis l'identifiant d'instance seul : l'identifiant
    /// d'exécution est celui de ce concept-ci.
    ///
    /// EXPLICITE, LÀ OÙ LE PACK LAISSAIT LA CONVERSION IMPLICITE. Toutes les clés du modèle
    /// ont la même forme, donc une conversion implicite depuis `UUId` fait de n'importe quel
    /// identifiant n'importe quelle clé, en silence -- ce que le typage des clés existe
    /// justement pour empêcher. `<c.name>Key{id}` dit la même chose et la dit exprès.
    explicit <c.name>Key(Viper::UUId const & instanceId) noexcept;

<c.membersInNamespace:club_constructor(c);separator="\n">

<c.membersInNamespace:club_getter(c);separator="\n">

    Viper::UUId const & instanceId() const noexcept;
    Viper::UUId const & runtimeId() const noexcept;

    /// Ce que la clé désigne, dit en clair, et si le modèle le connaît.
    ///
    /// LA RÉPONSE VIENT DES DÉFINITIONS, PAS DE LA GÉNÉRATION. Un identifiant d'exécution
    /// peut être celui d'un descendant qui n'existait pas quand ce fichier a été écrit ;
    /// les définitions embarquées, elles, sont lues à l'exécution et savent le nommer.
    std::string description() const;
    bool isKnown() const;
    bool isValid() const noexcept;

    <u.model.namespace>::AnyConceptKey toAny() const noexcept;
    <club_from(c)>

private:
    Viper::UUId _instanceId{};
    Viper::UUId _runtimeId{};
};

bool operator==(<c.name>Key const &, <c.name>Key const &) noexcept;
bool operator!=(<c.name>Key const &, <c.name>Key const &) noexcept;
bool operator\<(<c.name>Key const &, <c.name>Key const &) noexcept;

void hash(Viper::Hash::Accumulator & h, <c.name>Key const & value) noexcept;
>>

/// Depuis un membre : implicite, appartenir au club n'est pas une demande.
club_constructor(cm, c) ::= <<    <c.name>Key(<cm.nameInNamespace>Key const & key) noexcept;>>

/// Vers un membre : optionnel, l'instance pouvant relever d'un autre membre.
///
/// LE NOM DU GETTER PORTE L'UNITÉ DU MEMBRE QUAND CE N'EST PAS CELLE DU CLUB. Deux membres
/// peuvent s'appeler pareil -- `Core::Thing` et `Parts::Thing` -- et un nom de fonction ne
/// peut pas contenir `::`. C'est le préfixe plat, inévitable ici, et il ne dépend que du
/// membre : ajouter un membre n'en renomme jamais un autre.
club_getter(cm, c) ::= <<
    <club_getter_body(cm)>
>>
club_getter_body(cm) ::= <%std::optional\<<cm.nameInNamespace>Key> as<cm.asNameInNamespace>Key() const noexcept;%>

club_from(c) ::= <%static std::optional\<<c.name>Key> from(<u.model.namespace>::AnyConceptKey const & key) noexcept;%>

structure(s) ::= <<
<if(s.documentation)>/** <s.documentation> */
<endif>struct <s.name> final {
<s.fields:field();separator="\n">
};

bool operator==(<s.name> const &, <s.name> const &) noexcept;
bool operator!=(<s.name> const &, <s.name> const &) noexcept;
bool operator\<(<s.name> const &, <s.name> const &) noexcept;

void hash(Viper::Hash::Accumulator & h, <s.name> const & value) noexcept;
>>

field(f) ::= <<    <f.typeInNamespace> <f.name>{};>>

// LES STRUCTURES DANS L'ORDRE DE LEURS DÉPENDANCES, et non dans celui de leurs noms. Une
// unité les émet dans un seul fichier, donc une structure qui en contient une autre a
// besoin d'elle au-dessus -- `Bag` tient une `Colour`, et l'ordre alphabétique met `Bag`
// en premier. C'est la troisième fois que la même chose se présente : le parent d'un
// concept, puis les membres d'un club, maintenant les champs d'une structure.

// `enum class` et non `enum` : le scope nomme déjà l'unité, et une énumération non scopée
// verserait ses cases dans le namespace de l'unité, où elles heurteraient les noms des
// autres. Aucune valeur explicite -- ce qui traverse le fil est l'index de la case, et le
// modèle en est la source.
enumeration(e) ::= <<
<if(e.documentation)>/** <e.documentation> */
<endif>enum class <e.name> {
<e.members:enumeration_case();separator=",\n">
};

void hash(Viper::Hash::Accumulator & h, <e.name> value) noexcept;
>>

// Une sous-template nommée, et non `{m|    <m.name>}` : StringTemplate mange une espace
// après le `|`, donc l'indentation sort à trois caractères sans que rien ne le signale.
enumeration_case(m) ::= <<
    <m.name;format="uf">
>>

// UNE SEULE FORME DE SPÉCIALISATION, POUR TOUS LES TYPES. La première version en avait
// deux -- une clé se hachait par sa méthode, une structure par une fonction libre -- et la
// distinction n'avait aucune raison d'être. `hash(h, x)` est trouvé par ADL dans les deux
// cas, et le runtime hache un conteneur de la même écriture.
//
// L'ACCUMULATEUR EN PREMIER ARGUMENT N'EST PAS UN ORNEMENT. `hash(x)` sur un std::uint8_t
// ne peut pas marcher : un type fondamental n'a aucun namespace associé, donc l'ADL ne mène
// nulle part et la recherche ordinaire s'arrête dans l'unité. Un argument porté par le
// runtime la rétablit pour tous les types -- ce que `write(w, x)` obtient du Writer.
//
// La spécialisation est hors du namespace, donc le type doit être qualifié. `<%…%>` pour
// la ligne d'ouverture seulement : un `>>` dans le texte émis fermerait un corps `<<…>>`,
// et `<%…%>` mange les blancs de tête, donc la ligne indentée reste dans un `<<…>>`.
std_hash(e, u) ::= <<
<std_hash_head(e, u)>
    std::size_t operator()(<u.name>::<e.name>Key const & v) const noexcept { return Viper::Hash::of(v); }
};
>>

std_hash_head(e, u) ::= <%template\<> struct std::hash\<<u.name>::<e.name>Key> {%>

std_hash_value(e, u) ::= <<
<std_hash_value_head(e, u)>
    std::size_t operator()(<u.name>::<e.name> const & v) const noexcept { return Viper::Hash::of(v); }
};
>>

std_hash_value_head(e, u) ::= <%template\<> struct std::hash\<<u.name>::<e.name>> {%>
