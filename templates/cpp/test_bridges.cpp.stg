import "banner.stg"

pool(p) ::= <<
<preamble(p, p.include.pool)>

namespace <p.model.namespace>::<p.name;format="lsc"> {

<p.functions:stub();separator="\n\n">

} // namespace <p.model.namespace>::<p.name;format="lsc">

>>

attachment_pool(p) ::= <<
<preamble(p, p.include.attachment_pool)>

namespace <p.model.namespace>::<p.name;format="lsc"> {

<p.functions:attachment_stub();separator="\n\n">

} // namespace <p.model.namespace>::<p.name;format="lsc">

>>

preamble(p, include) ::= <<
// <p.name> -- stand-in implementations of the pool's functions, for testing the generated
// bridge on any model. Laboratory only.
//
<banner(p.model)>

#include "<include>"
>>

stub(f) ::= <<
<ret(f)> <f.name>(<f.parameters:param();separator=", ">) {
    <body(f)>
}
>>

attachment_stub(f) ::= <<
<ret(f)> <f.name>(std::shared_ptr\<Viper::Attachment<f.interfaceType>\> const &<if(f.parameters)>, <f.parameters:param();separator=", "><endif>) {
    <body(f)>
}
>>

body(f) ::= <%<if(f.isVoid)><else>return {};<endif>%>
ret(f) ::= <%<if(f.isVoid)>void<else><f.type><endif>%>
param(p) ::= <%<p.type><p.passBy>%>
