// Des implémentations de remplacement pour les fonctions d'un pool.
//
// LE SITE features ÉPROUVE N'IMPORTE QUEL DOSSIER DE DÉFINITIONS, et un modèle qui déclare des
// pools déclare des fonctions que seule son application implémente. Pour que le programme de
// test se lie quand même, chaque fonction reçoit ici un corps qui rend la valeur par défaut de
// son type. C'est le pont généré qui est éprouvé, pas le métier. Laboratoire seulement : un site
// qui a ses vrais ponts ne sélectionne pas cette feature.

pool(p) ::= <<
<preamble(p)>

namespace <p.model.namespace>::<p.name;format="lsc"> {

<p.functions:stub();separator="\n\n">

} // namespace <p.model.namespace>::<p.name;format="lsc">
>>

attachment_pool(p) ::= <<
<preamble(p)>

namespace <p.model.namespace>::<p.name;format="lsc"> {

<p.functions:attachment_stub();separator="\n\n">

} // namespace <p.model.namespace>::<p.name;format="lsc">
>>

preamble(p) ::= <<
// <p.name> -- stand-in implementations of the pool's functions, for testing the generated
// bridge on any model. Laboratory only.
//
// Generated by kibo from <p.model.namespace>. Do not edit by hand.
// <p.model.generated>

#include "<p.include.pool>"
>>

stub(f) ::= <<
<ret(f)> <f.name>(<f.parameters:param();separator=", ">) {
    <body(f)>
}
>>

attachment_stub(f) ::= <<
<ret(f)> <f.name>(std::shared_ptr\<Viper::Attachment<f.interfaceType>\> const &<if(f.parameters)>, <f.parameters:param();separator=", "><endif>) {
    <body(f)>
}
>>

body(f) ::= <%<if(f.isVoid)><else>return {};<endif>%>
ret(f) ::= <%<if(f.isVoid)>void<else><f.type><endif>%>
param(p) ::= <%<p.type><p.passBy>%>
