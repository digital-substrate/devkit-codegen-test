import "banner.stg"

main(m) ::= <<
// <m.namespace> reads -- the implementation.
//
<banner(m)>

#include "<m.namespace>_reads.hpp"

#include "shop_codec.hpp"
#include "shop_store_codec.hpp"

#include "Viper_Attachment.hpp"
#include "Viper_Definitions.hpp"
#include "Viper_Value.hpp"
#include "Viper_ValueSetIter.hpp"

<m.concepts:concept(m);separator="">
>>

concept(c, m) ::= <<
<c.attachments:attachment(m)>
>>

attachment(a, m) ::= <<
namespace <m.namespace>::attachments::<a.conceptScope>::<a.name> {

namespace {

std::shared_ptr\<Viper::Attachment> const & attachment() {
    static auto const instance{shop::codec::definitions()->checkAttachment(Viper::UUId::parse("<a.runtimeId>"))};
    return instance;
}

} // namespace

std::set\<shop::<a.keyType.type>\> keys(std::shared_ptr\<Viper::AttachmentGetting> const & getting) {
    std::set\<shop::<a.keyType.type>\> result;
    for (Viper::ValueSetIter it{getting->keys(attachment())}; it.hasNext(); it.next())
        result.insert(shop::codec::decode\<shop::<a.keyType.type>\>(it.value()));

    return result;
}

bool has(std::shared_ptr\<Viper::AttachmentGetting> const & getting, shop::<a.keyType.type> const & key) {
    return getting->has(attachment(), shop::codec::encode(key));
}

std::optional\<shop::<a.documentType.type>\> get(std::shared_ptr\<Viper::AttachmentGetting> const & getting, shop::<a.keyType.type> const & key) {
    auto const document{getting->get(attachment(), shop::codec::encode(key))};
    if (document->isNil())
        return std::nullopt;

    return shop::codec::decode\<shop::<a.documentType.type>\>(document->unwrap());
}

} // namespace <m.namespace>::attachments::<a.conceptScope>::<a.name>


>>
