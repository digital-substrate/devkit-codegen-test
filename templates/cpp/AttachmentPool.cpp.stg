// Les attachments du modèle, exposés au monde dynamique.
//
// LE PLUS GROS ARTEFACT DU PACK APRÈS LA BASE DE DONNÉES, ET IL N'A RIEN À GÉNÉRER. 764
// lignes de template qui produisent 9 125 lignes pour un modèle réel, et pas une seule ne
// nomme un type C++ : chaque corps caste ses arguments en `Viper::Value`, appelle
// l'interface, et rend une Value. Ce qui varie d'un attachment à l'autre -- son
// identifiant, les descripteurs de sa clé et de son document, le nom de ses fonctions --
// est déjà dans les `Definitions`.
//
// Donc le fichier est rendu une fois par modèle et ne dépend d'aucun : il parcourt les
// attachments et construit le pool. Il est ici pour la même raison que la clé non typée --
// le runtime livré ne le porte pas encore -- et il migrera de la même façon.

// TROIS FAMILLES, ET AUCUNE NE CONNAÎT UN TYPE DU MODÈLE :
//
//   sur l'attachment      keys, has, get          -- lecture
//                         set, diff               -- écriture du document entier
//   sur un champ          set\<Champ>              -- écriture partielle, par un chemin
//   sur un champ agrégé   union, subtract, update -- même forme, autre appel du runtime
//
// La dernière famille n'est pas écrite ici : elle se distingue des précédentes par le
// `TypeCode` du champ et par la méthode appelée, rien d'autre. Ce qui est écrit suffit à
// montrer ce qui était en question -- que la génération n'apporte rien.
//
// LE CHEMIN SE FABRIQUE ICI, ET C'EST LE POINT. Le pack appelle `Path::Colour::r()`, une
// fonction générée -- mais ce qu'elle rend est `Viper::Path::makeField("r")`, et le nom du
// champ est dans le descripteur de la structure. La couche 2 sert le développeur ; le pont
// dynamique n'en a pas besoin.
model(m) ::= <<
// <m.namespace> attachment pool -- built by walking the attachments of the definitions.
//
// Per attachment: keys, has, get, set, diff; per field of a structure document, a setter; and
// for an aggregate -- the document or a field -- union and subtract on a set, union, subtract
// and update on a map, insert, update and remove on an xarray. Functions are named
// namespace_concept_attachment_operation[_field] in snake case.
//
// Generated by kibo from <m.namespace>. Do not edit by hand.
// Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
// Runtime: this file links against the `viper` C++ runtime 1.2.x,
// distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
// Commercial use requires a Commercial Licence from Digital Substrate.
// <m.generated>

#include "<m.include.AttachmentPool>"

#include "<m.include.Codec>"

#include "Viper_Attachment.hpp"
#include "Viper_AttachmentGetting.hpp"
#include "Viper_AttachmentMutating.hpp"
#include "Viper_AttachmentFunction.hpp"
#include "Viper_AttachmentGettingFunction.hpp"
#include "Viper_AttachmentMutatingFunction.hpp"
#include "Viper_FunctionPrototype.hpp"
#include "Viper_Definitions.hpp"
#include "Viper_Path.hpp"
#include "Viper_StringHelper.hpp"
#include "Viper_Types.hpp"
#include "Viper_Values.hpp"
#include "Viper_ValueVoid.hpp"
#include "Viper_ValueSetIter.hpp"

namespace <m.namespace> {

namespace {

using Attachment = std::shared_ptr\<Viper::Attachment>;
using ValuePtr = std::shared_ptr\<Viper::Value>;
using Args = std::vector\<ValuePtr>;

/// A reading function, defined by what it does rather than what it acts on.
class Getting final : public Viper::AttachmentGettingFunction {
public:
    using Body = std::function\<ValuePtr(
        std::shared_ptr\<Viper::AttachmentGetting> const &, Attachment const &, Args const &)>;

    Getting(std::shared_ptr\<Viper::FunctionPrototype> prototype, std::string documentation,
            Attachment attachment, Body body)
    : Viper::AttachmentGettingFunction{std::move(prototype), std::move(documentation)}
    , _attachment{std::move(attachment)}, _body{std::move(body)} {}

    std::string representation() const override { return _attachment->identifier(); }

    ValuePtr checkedCall(
        std::shared_ptr\<Viper::AttachmentGetting> const & getting, Args const & args) const override {
        return _body(getting, _attachment, args);
    }

private:
    Attachment _attachment;
    Body _body;
};

class Mutating final : public Viper::AttachmentMutatingFunction {
public:
    using Body = std::function\<ValuePtr(
        std::shared_ptr\<Viper::AttachmentMutating> const &, Attachment const &, Args const &)>;

    Mutating(std::shared_ptr\<Viper::FunctionPrototype> prototype, std::string documentation,
             Attachment attachment, Body body)
    : Viper::AttachmentMutatingFunction{std::move(prototype), std::move(documentation)}
    , _attachment{std::move(attachment)}, _body{std::move(body)} {}

    std::string representation() const override { return _attachment->identifier(); }

    ValuePtr checkedCall(
        std::shared_ptr\<Viper::AttachmentMutating> const & mutating, Args const & args) const override {
        return _body(mutating, _attachment, args);
    }

private:
    Attachment _attachment;
    Body _body;
};

/// A function's name: namespace, concept, attachment and operation, in snake case --
/// `graph_vertex_visual_attributes_get`, the name a script or a peer calls it by. The rule is
/// the runtime's own converter, specified by shared test vectors; no generated client calls
/// these by name -- the bindings read and write the attachments directly.
std::string named(Attachment const & a, std::string const & operation) {
    using Viper::StringHelper::snakeCase;
    return snakeCase(a->typeName.nameSpace.name) + "_" + snakeCase(a->keyTypeName().name) + "_"
           + snakeCase(a->typeName.name) + "_" + operation;
}

void addReading(std::shared_ptr\<Viper::AttachmentFunctionPool> const & pool, Attachment const & a) {
    using P = Viper::FunctionPrototype;

    pool->add(std::make_shared\<Getting>(
        P::make(named(a, "keys"), {}, a->keysType),
        "return the set of keys.", a,
        [](auto const & g, auto const & at, auto const &) -> ValuePtr {
            return g->keys(at);
        }));

    pool->add(std::make_shared\<Getting>(
        P::make(named(a, "has"), {{"key", a->typeKey}}, type(Viper::StaticType::tag\<bool>{})),
        "return true if a document is present.", a,
        [](auto const & g, auto const & at, auto const & args) -> ValuePtr {
            return Viper::ValueBool::from(g->has(at, Viper::ValueKey::cast(args.at(0))));
        }));

    pool->add(std::make_shared\<Getting>(
        P::make(named(a, "get"), {{"key", a->typeKey}}, a->optionalDocumentType),
        "return an optional document.", a,
        [](auto const & g, auto const & at, auto const & args) -> ValuePtr {
            return g->get(at, Viper::ValueKey::cast(args.at(0)));
        }));
}

void addWriting(std::shared_ptr\<Viper::AttachmentFunctionPool> const & pool, Attachment const & a) {
    using P = Viper::FunctionPrototype;

    pool->add(std::make_shared\<Mutating>(
        P::make(named(a, "set"), {{"key", a->typeKey}, {"value", a->documentType}},
                Viper::TypeVoid::Instance()),
        "set the document.", a,
        [](auto const & m, auto const & at, auto const & args) -> ValuePtr {
            m->set(at, Viper::ValueKey::cast(args.at(0)), args.at(1));
            return Viper::ValueVoid::Instance();
        }));

    pool->add(std::make_shared\<Mutating>(
        P::make(named(a, "diff"),
                {{"key", a->typeKey}, {"value", a->documentType}, {"recursive", Viper::TypeBool::Instance()}},
                Viper::TypeVoid::Instance()),
        "write only what differs from the document.", a,
        [](auto const & m, auto const & at, auto const & args) -> ValuePtr {
            m->diff(at, Viper::ValueKey::cast(args.at(0)), args.at(1), Viper::ValueBool::cast(args.at(2))->value);
            return Viper::ValueVoid::Instance();
        }));
}

/// The mutations of an aggregate -- a set, a map or an xarray -- at `path`: the document itself
/// when `path` is the root, one of its fields otherwise. `suffix` names the field.
void addAggregate(std::shared_ptr\<Viper::AttachmentFunctionPool> const & pool, Attachment const & a,
                  std::shared_ptr\<Viper::Path const> const & path, std::shared_ptr\<Viper::Type> const & type,
                  std::string const & suffix) {
    using P = Viper::FunctionPrototype;
    auto const key = [](Args const & args) { return Viper::ValueKey::cast(args.at(0)); };
    auto const uuid = [](Args const & args, std::size_t i) { return Viper::ValueUUId::cast(args.at(i))->value; };
    auto const add = [&](std::string const & op, std::vector\<P::Parameter> parameters, std::string documentation,
                         Mutating::Body body) {
        // Parameter holds const members: build in order, it cannot be inserted at the front.
        std::vector\<P::Parameter> all{{"key", a->typeKey}};
        for (auto const & parameter : parameters)
            all.push_back(parameter);
        pool->add(std::make_shared\<Mutating>(P::make(named(a, op + suffix), std::move(all),
                                                      Viper::TypeVoid::Instance()),
                                              std::move(documentation), a, std::move(body)));
    };

    switch (type->typeCode) {
        case Viper::TypeCode::Set:
            add("union", {{"value", type}}, "add the elements of value.",
                [=](auto const & m, auto const & at, auto const & args) -> ValuePtr {
                    m->unionInSet(at, key(args), path, Viper::ValueSet::cast(args.at(1)));
                    return Viper::ValueVoid::Instance();
                });
            add("subtract", {{"value", type}}, "remove the elements of value.",
                [=](auto const & m, auto const & at, auto const & args) -> ValuePtr {
                    m->subtractInSet(at, key(args), path, Viper::ValueSet::cast(args.at(1)));
                    return Viper::ValueVoid::Instance();
                });
            break;

        case Viper::TypeCode::Map: {
            // Subtracting from a map takes its keys, not its entries.
            auto const keys = Viper::TypeSet::make(Viper::TypeMap::cast(type)->keyType);
            add("union", {{"value", type}}, "add the entries of value, replacing the map keys already there.",
                [=](auto const & m, auto const & at, auto const & args) -> ValuePtr {
                    m->unionInMap(at, key(args), path, Viper::ValueMap::cast(args.at(1)));
                    return Viper::ValueVoid::Instance();
                });
            add("subtract", {{"value", keys}}, "remove the entries whose map key is in value.",
                [=](auto const & m, auto const & at, auto const & args) -> ValuePtr {
                    m->subtractInMap(at, key(args), path, Viper::ValueSet::cast(args.at(1)));
                    return Viper::ValueVoid::Instance();
                });
            add("update", {{"value", type}}, "update the entries whose map key is already there.",
                [=](auto const & m, auto const & at, auto const & args) -> ValuePtr {
                    m->updateInMap(at, key(args), path, Viper::ValueMap::cast(args.at(1)));
                    return Viper::ValueVoid::Instance();
                });
            break;
        }

        case Viper::TypeCode::XArray: {
            auto const element = Viper::TypeXArray::cast(type)->elementType;
            auto const position = Viper::TypeUUId::Instance();
            add("insert", {{"before_position", position}, {"new_position", position}, {"value", element}},
                "insert value at new_position, before before_position.",
                [=](auto const & m, auto const & at, auto const & args) -> ValuePtr {
                    m->insertInXArray(at, key(args), path, uuid(args, 1), uuid(args, 2), args.at(3));
                    return Viper::ValueVoid::Instance();
                });
            add("update", {{"position", position}, {"value", element}}, "write value at position.",
                [=](auto const & m, auto const & at, auto const & args) -> ValuePtr {
                    m->updateInXArray(at, key(args), path, uuid(args, 1), args.at(2));
                    return Viper::ValueVoid::Instance();
                });
            add("remove", {{"position", position}}, "remove position.",
                [=](auto const & m, auto const & at, auto const & args) -> ValuePtr {
                    m->removeInXArray(at, key(args), path, uuid(args, 1));
                    return Viper::ValueVoid::Instance();
                });
            break;
        }

        default:
            break;
    }
}

/// Writing one field of a structure document, by its path.
void addFields(std::shared_ptr\<Viper::AttachmentFunctionPool> const & pool, Attachment const & a) {
    // `cast` throws on another type rather than answering null: ask first.
    if (a->documentType->typeCode != Viper::TypeCode::Structure)
        return;
    auto const structure = Viper::TypeStructure::cast(a->documentType);

    for (auto const & field : structure->fields()) {
        auto const path = Viper::Path::makeField(field->name);
        pool->add(std::make_shared\<Mutating>(
            Viper::FunctionPrototype::make(named(a, "set_" + Viper::StringHelper::snakeCase(field->name)),
                                           {{"key", a->typeKey}, {"value", field->type}},
                                           Viper::TypeVoid::Instance()),
            "set the property of the document.", a,
            [path](auto const & m, auto const & at, auto const & args) -> ValuePtr {
                m->update(at, Viper::ValueKey::cast(args.at(0)), path, args.at(1));
                return Viper::ValueVoid::Instance();
            }));
        addAggregate(pool, a, path, field->type, "_" + Viper::StringHelper::snakeCase(field->name));
    }
}

} // namespace

std::shared_ptr\<Viper::AttachmentFunctionPool> attachment_pool() {
    static auto const instance = [] {
        auto const pool = Viper::AttachmentFunctionPool::make(
            Viper::UUId::parse("00000000-0000-0000-0000-000000000000"), "Attachments");

        for (auto const & a : codec::definitions()->attachments()) {
            addReading(pool, a);
            addWriting(pool, a);
            addAggregate(pool, a, Viper::Path::make(), a->documentType, "");
            addFields(pool, a);
        }
        return pool;
    }();
    return instance;
}

} // namespace <m.namespace>

>>
