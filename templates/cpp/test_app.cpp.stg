// Le programme qui éprouve le modèle.
//
// LE SEUL ARTEFACT QUI ÉNUMÈRE LES UNITÉS, et c'est sa raison d'être. Tout le reste produit
// du code par unité, qui ne connaît que lui-même ; quelqu'un doit dire qu'un modèle est fait
// de celles-ci. C'est un assemblage, donc c'est du socle.
//
// LE PACK EN ÉCRIT QUATRE -- codec, base, base en fuzz, base distante -- qui ne diffèrent que
// par les options acceptées et les appels lancés. Ici il y en a un, parce que ce qu'ils
// lancent est devenu une liste et non sept familles de fonctions.

model(m) ::= <<
// <m.namespace> test programme -- runs every test of the model.
//
// Generated by kibo from <m.namespace>. Do not edit by hand.
// Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
// Runtime: this file links against the `viper` C++ runtime 1.2.x,
// distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
// Commercial use requires a Commercial Licence from Digital Substrate.
// <m.generated>

#include "<m.include.test>"

<m.nameSpaces:{u|#include "<u.include.test>"};separator="\n">
<m.functionPools:{p|#include "<p.include.pool>"};separator="\n">
<m.attachmentFunctionPools:{p|#include "<p.include.pool>"};separator="\n">

#include "Viper_Database.hpp"
#include "Viper_DatabaseTransactionMode.hpp"

#include \<cstddef>
#include \<cstdlib>
#include \<iostream>
#include \<string>

namespace {

/// The model's namespaces, in declaration order.
void testTypes() {
<m.nameSpaces:call_test();separator="\n">
}

void testDatabase(std::shared_ptr\<Viper::Database> const & db) {
<m.nameSpaces:call_database();separator="\n">
}

void fuzzDatabase(std::shared_ptr\<Viper::Database> const & db, std::size_t count) {
<m.nameSpaces:call_fuzz();separator="\n">
}

} // namespace

int main(int argc, char * argv[]) {
    // An explicit seed makes the sequence reproducible; without one each run tests
    // something else, which is the point.
    if (argc > 2 && std::string{argv[1]} == "--seed")
        <m.namespace>::test::seed(std::strtoull(argv[2], nullptr, 10));

    try {
        testTypes();

        auto const db = Viper::Database::createInMemory();

        // The model's definitions go into the database.
        db->extendDefinitions(<m.namespace>::codec::definitions());

        // The database refuses to write outside a transaction.
        db->beginTransaction(Viper::DatabaseTransactionMode::Exclusive);

        // What the database offers outside the model.
        <m.namespace>::test::testMetadata(db);
        <m.namespace>::test::testBlobCreate(db);
        <m.namespace>::test::testBlobStream(db);
        <m.namespace>::test::testBlobIO(db);

        // A blob exists during the attachment tests: a document may hold a blob id, and the
        // database refuses one that names no blob.
        <m.namespace>::test::withBlob(db);
        testDatabase(db);
        fuzzDatabase(db, 32);
        <m.namespace>::test::withoutBlob(db);
<if(m.functionPools)>

        // Every function of every pool, called through the dynamic bridge with arguments
        // fuzzed from its prototype.
<m.functionPools:call_pool();separator="\n">
<endif>
<if(m.attachmentFunctionPools)>
<m.attachmentFunctionPools:call_attachment_pool();separator="\n">
<endif>

        db->commit();
        db->close();
    } catch (std::exception const & e) {
        std::cerr \<\< "échec : " \<\< e.what() \<\< std::endl;
        return 1;
    }

    std::cout \<\< "ok" \<\< std::endl;
    return 0;
}
>>

// Une sous-template nommée : StringTemplate mange une espace après le `|` d'une anonyme, et
// l'indentation sortirait à trois caractères sans que rien ne le signale.
call_test(u) ::= <<
    <u.model.namespace>::<u.name;format="lsc">::test();
>>

call_database(u) ::= <<
    <u.model.namespace>::<u.name;format="lsc">::testDatabase(db);
>>

call_fuzz(u) ::= <<
    <u.model.namespace>::<u.name;format="lsc">::fuzzDatabase(db, count);
>>

call_pool(p) ::= <<
        <m_test(p)>::testPool(<p.model.namespace>::<p.name;format="lsc">::pool());
>>

call_attachment_pool(p) ::= <<
        <m_test(p)>::testPool(<p.model.namespace>::<p.name;format="lsc">::pool(), db);
>>

m_test(p) ::= <%<p.model.namespace>::test%>
