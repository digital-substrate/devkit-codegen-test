// Le point d'entrée d'un pool, et seulement lui.
//
// À PART DE CELUI DES UNITÉS, ET C'EST TOUTE LA RAISON DE CE FICHIER. Tant qu'il vivait dans
// `__init__.py.stg`, sélectionner `Base` seul rendait quand même un paquet par pool, qui
// importait un `pool.py` absent. Une application Python pure -- qui ne peut pas construire de
// pool -- recevait des paquets cassés pour chaque pool que son modèle déclare. Ici, il ne vient
// qu'avec la feature `Pool`. Même nom de sortie, `__init__.py` : c'est pour cela qu'il est dans
// son propre dossier.

pool(p) ::= <<
<preamble(p.model)>
"""<p.name> — ce que ce pool expose.

Un pool est une unité, donc un paquet, et son initialisateur ne porte que des noms comme
celui de n'importe quelle autre. Rien ici ne distingue un pool d'un namespace, et c'est le
propos : ce qui les sépare est ce qu'ils contiennent, pas la forme qu'ils prennent.

    from <p.model.namespace;format="lsc">.<p.name;format="lsc"> import Pool, Remote
"""

from .pool import Pool, Remote
>>

attachment_pool(p) ::= <<
<pool(p)>
>>

preamble(m) ::= <<
# Generated by kibo from <m.namespace>. Do not edit by hand.
# Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
# Runtime: this file imports `dsviper` 1.2.x,
