// Les attachments que déclare une unité.
//
// UN ATTACHMENT EST UN OBJET, PAS UNE FAMILLE DE FONCTIONS. Le pack écrit
// `modela_material_colour_get(getting, key)` : le namespace, le concept et le nom de
// l'attachment collés dans un identifiant, parce qu'un module plat n'a aucun autre moyen de
// les distinguer. Ici le module est le namespace, la classe est le concept et l'attribut est
// l'attachment — les trois parties du nom redeviennent trois portées.
//
// EN C++ IL FALLAIT UNE PORTÉE parce qu'une fonction ne peut pas être une valeur. En Python
// elle peut : `colour` est un objet, donc `get`, `set` et `keys` sont ses méthodes et non des
// fonctions qui répètent son nom. 188 lignes de template du pack rendent 2 454 lignes pour un
// modèle réel ; ici l'objet est écrit une fois dans le runtime et l'unité en déclare un par
// attachment.

unit(u) ::= <<
# Generated by kibo from <u.model.namespace>. Do not edit by hand.
# Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
# Runtime: this file imports `dsviper` 1.2.x,
# distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
# Commercial use requires a Commercial Licence from Digital Substrate.
# <u.model.generated>

"""<u.name> — les attachments que ce namespace déclare."""

from __future__ import annotations

import dsviper

from .. import definitions
from .._codegen import AnyConceptKey, AttachmentProxy
<u.dependencies.attachments:{d|from .. import <d.name;format="lsc">};separator="\n">
<if(u.attachments)>
from .data import *
<endif>


<u.attachmentScopes:by_concept(u);separator="\n\n">
>>

// UNE CLASSE PAR CONCEPT PORTEUR, ET TOUS SES ATTACHMENTS DEDANS. Le concept peut appartenir
// à une autre unité -- `Annotations::note` est porté par `ModelA::Material` -- et c'est alors
// le nom de l'unité d'origine qui nomme la classe, faute de quoi deux attachments homonymes
// sur deux concepts homonymes se heurteraient.
//
// LE GROUPEMENT VIENT DU MODÈLE ET NON D'ICI. En C++ trois `namespace Link` fusionnent, donc
// une portée par attachment suffisait ; trois `class Link` ne fusionnent pas, il n'en reste
// qu'une et les deux premières disparaissent sans que rien le dise.
by_concept(s, u) ::= <<
class <s.name>:
    """Les attachments portés par <s.keyType.type>."""

<s.attachments:one(s);separator="\n\n">


<s.name;format="lsc"> = <s.name>()
>>

one(a, s) ::= <<
    <a.name> = AttachmentProxy(
        dsviper.ValueUUId.create("<a.runtimeId>"),
        definitions, <s.keyType.bindingType.typeInNamespace>, <document(a)>)
>>

// LE DOCUMENT N'A UNE CLASSE QUE SI UNE UNITÉ LE DÉCLARE. Une structure, une énumération,
// une clé en ont une ; un `string`, un `map<…>` ou un `xarray<…>` n'en ont pas et n'en ont
// pas besoin — le runtime les rend déjà comme objets Python. `None` dit qu'il n'y a rien à
// envelopper, et c'est aussi la réponse pour les conteneurs que le pack, lui, générait un
// par forme.
document(a) ::= <%<if(a.documentType.bindingType.isNamed)><a.documentType.bindingType.typeInNamespace><else>None<endif>%>
