// Les attachments que déclare une unité.
//
// L'ÉCRITURE EST CELLE DU C++, DANS L'IDIOME DE PYTHON. `gei::graph::attachments::Graph::
// selection::unionVertexKeys` s'écrit ici `gei.graph.attachments.Graph.selection.
// union_vertex_keys` : le module est le namespace, la classe est le concept -- avec la casse
// du type, comme en C++ --, l'attribut est l'attachment et la méthode l'opération. Le chemin
// épelle aussi le nom que le pool d'attachments donne à la même opération,
// `graph_graph_selection_union_vertex_keys`.
//
// LES OPÉRATIONS D'UN DOCUMENT SONT GÉNÉRÉES, UNE MÉTHODE PAR CHAMP. C'est avec elles que
// s'écrit le code métier ; il lui faut la complétion, les types et une faute de frappe vue à
// l'import, pas à l'appel. Ce qui ne dépend pas du document -- `get`, `set`, `keys` -- est
// hérité du runtime et typé par ses deux paramètres.

unit(u) ::= <<
# Generated by kibo from <u.model.namespace>. Do not edit by hand.
# Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
# Runtime: this file imports `dsviper` 1.2.x,
# distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
# Commercial use requires a Commercial Licence from Digital Substrate.
# <u.model.generated>

"""<u.name> — les attachments que ce namespace déclare."""

from __future__ import annotations

import dsviper

from .. import definitions
import typing

from .._codegen import AnyConceptKey, AttachmentProxy, Mapping, Ordered, Sequence
from .. import <u.name;format="lsc">
<u.dependencies.attachments:{d|from .. import <d.name;format="lsc">};separator="\n">


<u.attachmentScopes:by_concept(u);separator="\n\n">
>>

// UNE CLASSE PAR CONCEPT PORTEUR, ET TOUS SES ATTACHMENTS DEDANS. Le concept peut appartenir
// à une autre unité -- `Annotations::note` est porté par `ModelA::Material` -- et c'est alors
// le nom de l'unité d'origine qui nomme la classe, faute de quoi deux attachments homonymes
// sur deux concepts homonymes se heurteraient.
//
// LE GROUPEMENT VIENT DU MODÈLE ET NON D'ICI. En C++ trois `namespace Link` fusionnent, donc
// une portée par attachment suffisait ; trois `class Link` ne fusionnent pas, il n'en reste
// qu'une et les deux premières disparaissent sans que rien le dise.
by_concept(s, u) ::= <<
class <s.name>:
    """Les attachments portés par <s.keyType.type>."""

<s.attachments:one(s);separator="\n\n">
>>

// UN ATTACHMENT SANS OPÉRATION PROPRE N'A PAS DE CLASSE À LUI. Un document scalaire, ou une
// structure sans champ, n'offre que ce que le runtime offre déjà à tous.
one(a, s) ::= <%<if(a.documentType.isStructure)><own(a, s)><elseif(a.documentType.field.isNotBox)><own(a, s)><else><plain(a, s)><endif>%>

plain(a, s) ::= <<
    <a.name;format="snake"> = AttachmentProxy[<generics(a, s)>](
        <arguments(a, s)>)
>>

own(a, s) ::= <<
    class _<a.name;format="uf">(AttachmentProxy[<generics(a, s)>]):
        """<s.keyType.type> -> <a.documentType.bindingType.qualified>, avec ses opérations."""

        <if(a.documentType.isStructure)><a.documentType.structure.fields:field(a, s);separator="\n\n"><else><document(a, s)><endif>

    <a.name;format="snake"> = _<a.name;format="uf">(
        <arguments(a, s)>)
>>

generics(a, s) ::= <%<s.keyType.bindingType.qualified>, <a.documentType.bindingType.qualified>%>
arguments(a, s) ::= <%dsviper.ValueUUId.create("<a.runtimeId>"), definitions, <s.keyType.bindingType.qualified>, <documentClass(a)>%>

// LE DOCUMENT N'A UNE CLASSE QUE SI UNE UNITÉ LE DÉCLARE. Une structure, une énumération,
// une clé en ont une ; un `string`, un `map<…>` ou un `xarray<…>` n'en ont pas et n'en ont
// pas besoin — le runtime les rend déjà comme objets Python.
documentClass(a) ::= <%<if(a.documentType.bindingType.isNamed)><a.documentType.bindingType.qualified><else>None<endif>%>

// ── un champ du document ──
//
// `set_` pour tous ; et quand le champ est un agrégat, les mutations qui ajoutent, retirent
// ou déplacent à l'intérieur -- deux écritures concurrentes sur le même ensemble se fondent
// là où deux remplacements s'écrasent. Le chemin garde le nom du modèle : c'est celui du
// runtime.
field(sf, a, s) ::= <<
def set_<sf.name;format="snake">(self, mutating: dsviper.AttachmentMutating, key: <s.keyType.bindingType.qualified>, value: <sf.bindingType.qualified>) -> None:
    """Écrire le champ `<sf.name>` du document tenu à `key`."""
    self._update(mutating, key, "<sf.name>", value)<if(sf.field.isSet)>

<set_ops(sf.field, s, {"<sf.name>"}, {_<sf.name;format="snake">}, sf.name)><elseif(sf.field.isMap)>

<map_ops(sf.field, s, {"<sf.name>"}, {_<sf.name;format="snake">}, sf.name)><elseif(sf.field.isXArray)>

<xarray_ops(sf.field, s, {"<sf.name>"}, {_<sf.name;format="snake">}, sf.name)><endif>
>>

// ── le document est lui-même l'agrégat ──
//
// Les mêmes opérations, à la racine : le suffixe tombe, le chemin est `None`.
document(a, s) ::= <%<if(a.documentType.field.isSet)><set_ops(a.documentType.field, s, "None", "", false)><elseif(a.documentType.field.isMap)><map_ops(a.documentType.field, s, "None", "", false)><elseif(a.documentType.field.isXArray)><xarray_ops(a.documentType.field, s, "None", "", false)><endif>%>

set_ops(t, s, path, suffix, label) ::= <<
def union<suffix>(self, mutating: dsviper.AttachmentMutating, key: <s.keyType.bindingType.qualified>, value: typing.Iterable[<t.bindingElementType.qualified>]) -> None:
    """Ajouter des éléments au set<if(label)> `<label>`<endif>."""
    self._union_in_set(mutating, key, <path>, value)

def subtract<suffix>(self, mutating: dsviper.AttachmentMutating, key: <s.keyType.bindingType.qualified>, value: typing.Iterable[<t.bindingElementType.qualified>]) -> None:
    """Retirer des éléments du set<if(label)> `<label>`<endif>."""
    self._subtract_in_set(mutating, key, <path>, value)
>>

// Retirer d'une map, c'est retirer des clés : l'argument est un ensemble de clés et non une
// map -- demander les valeurs pour effacer laisserait croire qu'elles comptent.
map_ops(t, s, path, suffix, label) ::= <<
def union<suffix>(self, mutating: dsviper.AttachmentMutating, key: <s.keyType.bindingType.qualified>, value: typing.Mapping[<t.bindingKeyType.qualified>, <t.bindingElementType.qualified>]) -> None:
    """Ajouter des entrées à la map<if(label)> `<label>`<endif>, en remplaçant les clés déjà là."""
    self._union_in_map(mutating, key, <path>, value)

def subtract<suffix>(self, mutating: dsviper.AttachmentMutating, key: <s.keyType.bindingType.qualified>, value: typing.Iterable[<t.bindingKeyType.qualified>]) -> None:
    """Retirer de la map<if(label)> `<label>`<endif> les entrées dont la clé est donnée."""
    self._subtract_in_map(mutating, key, <path>, value)

def update<suffix>(self, mutating: dsviper.AttachmentMutating, key: <s.keyType.bindingType.qualified>, value: typing.Mapping[<t.bindingKeyType.qualified>, <t.bindingElementType.qualified>]) -> None:
    """Mettre à jour les entrées de la map<if(label)> `<label>`<endif> dont la clé est déjà là ; les autres sont ignorées."""
    self._update_in_map(mutating, key, <path>, value)
>>

xarray_ops(t, s, path, suffix, label) ::= <<
def insert<suffix>(self, mutating: dsviper.AttachmentMutating, key: <s.keyType.bindingType.qualified>, before_position: dsviper.ValueUUId, new_position: dsviper.ValueUUId, value: <t.bindingElementType.qualified>) -> None:
    """Insérer dans la xarray<if(label)> `<label>`<endif> ; `ValueUUId.INVALID` comme `before_position` ajoute à la fin."""
    self._insert_in_xarray(mutating, key, <path>, before_position, new_position, value)

def update<suffix>(self, mutating: dsviper.AttachmentMutating, key: <s.keyType.bindingType.qualified>, position: dsviper.ValueUUId, value: <t.bindingElementType.qualified>) -> None:
    """Écrire l'élément à `position` dans la xarray<if(label)> `<label>`<endif>."""
    self._update_in_xarray(mutating, key, <path>, position, value)

def remove<suffix>(self, mutating: dsviper.AttachmentMutating, key: <s.keyType.bindingType.qualified>, position: dsviper.ValueUUId) -> None:
    """Retirer l'élément à `position` de la xarray<if(label)> `<label>`<endif>."""
    self._remove_in_xarray(mutating, key, <path>, position)
>>
