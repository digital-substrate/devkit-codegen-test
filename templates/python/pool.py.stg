# <p.model.generated>

"""<p.name> — le pool, et le même vu d'un client."""

from __future__ import annotations

import typing

import dsviper

from .._codegen import AnyConceptKey, Mapping, Ordered, Sequence, wrap

<p.dependencies.functions:{d|from .. import <d.name;format="lsc">};separator="\n">
>>

function(f) ::= <<
    def <f.name;format="snake">(self<if(f.parameters)>, <f.parameters:parameter();separator=", "><endif>) -> <ret(f)>:
        <call(f)>
>>

attachment_function(f) ::= <<
    def <f.name;format="snake">(self, attachment_<f.interfaceType;format="lsc">: dsviper.Attachment<f.interfaceType><if(f.parameters)>, <f.parameters:parameter();separator=", "><endif>) -> <ret(f)>:
        <attachment_call(f)>
>>

parameter(a) ::= <%<a.name;format="snake">: <hint(a.bindingType)>%>
ret(f) ::= <%<if(f.isVoid)>None<else><hint(f.returnBindingType)><endif>%>
argument(a) ::= <%<if(a.bindingType.isNamed)><a.name;format="snake">._unwrap()<else><a.name;format="snake"><endif>%>

// DEUX APPELS ET NON UN PARAMÉTRÉ. Le contexte d'un pool d'attachments n'existe que sur une
// fonction d'attachment, et StringTemplate évalue une propriété même sous un `if` qui
// l'écarte : un seul template partagé chercherait `interfaceType` sur une fonction ordinaire
// et le diagnostic ne nommerait que la propriété.
call(f) ::= <%<if(f.isVoid)>self._funcs["<f.name>"](<f.parameters:argument();separator=", ">)<else>return <wrap(f)>self._funcs["<f.name>"](<f.parameters:argument();separator=", ">)<unwrap(f)><endif>%>
attachment_call(f) ::= <%<if(f.isVoid)>self._funcs["<f.name>"](attachment_<f.interfaceType;format="lsc"><if(f.parameters)>, <endif><f.parameters:argument();separator=", ">)<else>return <wrap(f)>self._funcs["<f.name>"](attachment_<f.interfaceType;format="lsc"><if(f.parameters)>, <endif><f.parameters:argument();separator=", ">)<unwrap(f)><endif>%>
// TOUT RETOUR PASSE PAR LE REGISTRE, ET RIEN N'Y ÉCHAPPE. Envelopper seulement les types
// nommés laissait mentir l'annotation : `has_player` promettait `PlayerKey | None` et
// rendait un `ValueOptional` brut -- un consommateur qui suit la signature reçoit un
// AttributeError. Le registre, lui, lit le type que la valeur porte : il dénoue
// l'optionnel, choisit la classe d'une clé selon son concept réel, et laisse passer les
// primitifs tels quels. Une seule règle, et l'annotation redevient vraie.
wrap(f) ::= <%wrap(%>
unwrap(f) ::= <%)%>

hint(b) ::= <%<b.annotation>%>
