// Ce qui rend le paquet installable, et donc typé.
//
// LE PACK N'EN GÉNÉRAIT PAS POUR CE MODÈLE, et sans lui `pip install` répond « Neither
// setup.py nor pyproject.toml found ». Quatre écarts du `wheel` d'origine sont corrigés ici,
// chacun mesuré :
//
//   1. `packages.find` ne listait que le paquet racine. Un namespace est un sous-paquet ;
//      sans `<pkg>.*` ils sont tous absents de la distribution.
//   2. `package-data` n'emballait pas `py.typed`, donc le marqueur pouvait exister dans
//      l'arbre et manquer dans la roue -- le pire des deux mondes.
//   3. aucune dépendance déclarée, alors que chaque module généré importe `dsviper`.
//   4. `readme = "README.rst"` désignait un fichier que rien ne génère : la construction
//      échoue avant de commencer.
model(m) ::= <<
# Generated by kibo from <m.namespace>. Do not edit by hand.
# Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
# Runtime: this file declares a dependency on `dsviper` 1.2.x,
# distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
# Commercial use requires a Commercial Licence from Digital Substrate.
# <m.generated>

[build-system]
requires = ["setuptools"]
build-backend = "setuptools.build_meta"

[project]
name = "<m.namespace;format="lsc">"
version = "1.0.0"
description = "Generated Python bindings for the <m.namespace> model"
requires-python = ">=3.10"
license = { text = "Proprietary" }
dependencies = ["dsviper ~= 1.2"]

[tool.setuptools.packages.find]
include = ["<m.namespace;format="lsc">", "<m.namespace;format="lsc">.*"]

[tool.setuptools.package-data]
"<m.namespace;format="lsc">" = ["py.typed", "*.pyi"]
>>
