// A driver model, as if owned by one vendor. Deliberately declares the same
// names as ModelB: Material and Colour collide across the two namespaces.
namespace ModelA {8c24c1b9-cfbf-4f3f-897d-43fd684d140d} {

"""A material, as ModelA understands one."""
concept Material;

"""An asset, with a field named after another field's path: package and packagePath."""
struct Asset {
  string package;
  string packagePath;
};

"""Colour in 8-bit channels -- the same name as ModelB::Colour, a different type."""
struct Colour {
  uint8 r;
  uint8 g;
  uint8 b;
};

"""An enumeration, so the templates meet one. No other namespace declares one, on
purpose: what is tested here is the topology, not the type system -- but a layer that
cannot serialise an enumeration is incomplete."""
enum Finish {
  matte ,
  gloss
};

attachment<Material, Colour> colour;

"""A concept named as another concept's key: `MaterialKey` is the key of Material, and here
also a concept of its own, whose key is `MaterialKeyKey`. A real model has one
(`TimelineTriggerKey`). Its attachments open a scope `attachments::MaterialKey`, and a
document naming Material's key must still reach the type, not that scope."""
concept MaterialKey;

struct MaterialKeyNote {
  key<Material> material;
};

attachment<MaterialKey, MaterialKeyNote> note;

}; // ns
