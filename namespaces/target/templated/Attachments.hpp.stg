unit(u) ::= <<
// <u.name> — the data hung on concepts, declared by this namespace.
//
// <u.model.generated>
//
// One scope per attachment, under the concept it is keyed on. The concept's own unit is
// part of the scope name whenever it is not this one: a namespace level cannot hold a
// qualified name, so `ModelA::Material` becomes `ModelA_Material` there -- and always,
// not only when two attachments would otherwise collide, so that adding one never
// renames another.

#ifndef <u.name>_Attachments_hpp
#define <u.name>_Attachments_hpp

#include "<u.include.Data>"
<u.dependencies.attachments:{d|#include "<d.include.Data>"};separator="\n">

#include "Viper_AttachmentGetting.hpp"
#include "Viper_AttachmentMutating.hpp"
#include "Viper_UUId.hpp"

#include \<cstdint>
#include \<optional>
#include \<set>

<u.attachments:attachment(u);separator="\n\n">

#endif
>>

// LA SURFACE EST CELLE DU RUNTIME. Viper::AttachmentMutating offre set, diff et update,
// et rien qui retire un document -- le premier jet déclarait un `remove` qui n'existe
// nulle part. Ce que update permet de plus, c'est d'écrire un champ plutôt que le document
// entier, et cela donne un setter par champ : lier le chemin et le type du champ dans une
// même signature est ce qui rend le chemin sûr.
//
// `/** */` et non `///` : une documentation du modèle tient sur plusieurs lignes, et `///`
// ne commente que la première -- le reste part dans le code. Un bloc le supporte sans que
// le modèle ait à découper quoi que ce soit.
attachment(a, u) ::= <<
<if(a.hasDocumentation)>/** <a.documentation> */
<endif>namespace <u.name>::Attachments::<a.conceptScope>::<a.name> {

/// L'identité de cet attachment dans le modèle. La portée nomme déjà l'attachment, donc
/// il ne reste que le nom.
extern Viper::UUId const runtimeId;

<keys(a)>

bool has(Viper::AttachmentGetting const & getting, <a.keyType.typeInNamespace> const & key);

<get(a)>

void set(Viper::AttachmentMutating & mutating, <a.keyType.typeInNamespace> const & key, <a.documentType.typeInNamespace> const & value);

void diff(Viper::AttachmentMutating & mutating, <a.keyType.typeInNamespace> const & key, <a.documentType.typeInNamespace> const & value,
          bool recursive = false);
<if(a.documentType.isStructure)>

<a.documentType.structure.fields:field(a);separator="\n">
<endif>

} // namespace <u.name>::Attachments::<a.conceptScope>::<a.name>
>>

/// Un setter par champ du document -- l'unique consommateur des chemins de la couche 2.
field(sf, a) ::= <<void set<sf.name;format="uf">(Viper::AttachmentMutating & mutating, <a.keyType.typeInNamespace> const & key, <sf.type><sf.passBy> value);>>


// `<%…%>`, because a `>>` in the emitted text would close a `<<…>>` body. Every generic
// type crossing into the output hits this.
keys(a) ::= <%std::set\<<a.keyType.typeInNamespace>> keys(Viper::AttachmentGetting const & getting);%>
get(a) ::= <%std::optional\<<a.documentType.typeInNamespace>> get(Viper::AttachmentGetting const & getting, <a.keyType.typeInNamespace> const & key);%>
