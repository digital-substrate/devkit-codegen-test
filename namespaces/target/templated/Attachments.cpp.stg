// L'implémentation des attachments d'une unité.
//
// Elle tient en quelques lignes par attachment parce que trois modules se partagent le
// travail, et que chacun est nommé une fois : l'unité fournit write/read/type pour ses
// types, le module injecté fournit encode/decode et definitions(), le runtime fournit
// tout le reste. Aucun nom plat par type n'apparaît, et ce n'est pas une convention de
// nommage -- c'est l'argument qui désigne l'unité, par ADL.

unit(u) ::= <<
// unité <u.name> — l'implémentation des attachments qu'elle déclare.
//
// <u.model.generated>

#include "<u.include.Attachments>"

#include "<u.include.Codec>"
#include "<u.include.Fields>"
#include "<u.include.Model>"
<u.dependencies.attachments:{d|#include "<d.include.Codec>"};separator="\n">
<u.dependencies.attachments:{d|#include "<d.include.Model>"};separator="\n">
<u.dependencies.attachments:{d|#include "<d.include.Fields>"};separator="\n">

#include "<u.model.include.Codec>"
#include "<u.model.include.Db>"

#include "Viper_Attachment.hpp"
#include "Viper_Definitions.hpp"
#include "Viper_Path.hpp"
#include "Viper_Values.hpp"
#include "Viper_ValueSetIter.hpp"

<u.attachments:attachment(u);separator="\n\n">
>>

attachment(a, u) ::= <<
namespace <u.name>::Attachments::<a.conceptScope>::<a.name> {

Viper::UUId const runtimeId{Viper::UUId::parse("<a.runtimeId>")};

std::shared_ptr\<Viper::Attachment> const & descriptor() {
    static auto const instance = <u.model.namespace>::Codec::definitions()->checkAttachment(runtimeId);
    return instance;
}

namespace {

std::shared_ptr\<Viper::Attachment> const & attachment() { return descriptor(); }

<encode_key(a, u)>

} // namespace

<keys(a, u)>

bool has(std::shared_ptr\<Viper::AttachmentGetting> const & getting, <a.keyType.typeInNamespace> const & key) {
    return getting->has(attachment(), encodeKey(key));
}

<get(a, u)>

void set(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <a.documentType.typeInNamespace> const & value) {
    mutating->set(attachment(), encodeKey(key), <u.model.namespace>::Codec::encode(value));
}

void diff(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <a.documentType.typeInNamespace> const & value,
          bool recursive) {
    mutating->diff(attachment(), encodeKey(key), <u.model.namespace>::Codec::encode(value), recursive);
}

bool set(std::shared_ptr\<Viper::Database> const & db, <a.keyType.typeInNamespace> const & key, <a.documentType.typeInNamespace> const & value) {
    return <u.model.namespace>::Db::set(db, attachment(), key, value);
}

bool del(std::shared_ptr\<Viper::Database> const & db, <a.keyType.typeInNamespace> const & key) {
    return <u.model.namespace>::Db::del(db, attachment(), key);
}
<if(a.documentType.isStructure)>

<a.documentType.structure.fields:field(a, u);separator="\n\n">
<elseif(a.documentType.field.isNotBox)>

<a:document_aggregate(u)>
<endif>

} // namespace <u.name>::Attachments::<a.conceptScope>::<a.name>
>>

// Un setter par champ du document. Le chemin vient de la couche 2, la valeur du module
// injecté, et le type du champ de la signature -- les trois liés en un seul endroit, ce
// qu'une surcharge générique prenant (chemin, valeur) ne ferait pas.
field(sf, a, u) ::= <<
void set<sf.name;format="uf">(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <sf.typeInNamespace><sf.passBy> value) {
    mutating->update(attachment(), encodeKey(key), <path(sf, a)>,
                    <u.model.namespace>::Codec::encode(value));
}
<if(sf.field.isSet)>

<sf:field_set(a, u)>
<elseif(sf.field.isMap)>

<sf:field_map(a, u)>
<elseif(sf.field.isXArray)>

<sf:field_xarray(a, u)>
<endif>
>>

// L'ADRESSE EST LA SEULE VARIABLE ENTRE LES DEUX FAMILLES. Un champ a la sienne, un
// document est à la racine, et les huit corps sont identiques par ailleurs.
path(sf, a) ::= <%<a.documentType.structure.namespace>::Fields::<a.documentType.structure.name>::<sf.name>Path()%>
root() ::= <%Viper::Path::make()%>

// LE CAST N'EST PAS UNE FORMALITÉ. Le runtime veut un `ValueSet` là où le générique rend
// une `Value` : c'est la seule chose que le modèle sait et que le type C++ ne dit pas.
mutate(op, viper, address, value, u) ::= <%mutating-><op>(attachment(), encodeKey(key), <address>, Viper::<viper>::cast(<u.model.namespace>::Codec::encode(<value>)));%>

field_set(sf, a, u) ::= <<
void union<sf.name;format="uf">(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <sf.typeInNamespace> const & value) {
    <mutate("unionInSet", "ValueSet", path(sf, a), "value", u)>
}

void subtract<sf.name;format="uf">(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <sf.typeInNamespace> const & value) {
    <mutate("subtractInSet", "ValueSet", path(sf, a), "value", u)>
}
>>

field_map(sf, a, u) ::= <<
void union<sf.name;format="uf">(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <sf.typeInNamespace> const & value) {
    <mutate("unionInMap", "ValueMap", path(sf, a), "value", u)>
}

<field_subtract_map_head(sf, a)>
    <mutate("subtractInMap", "ValueSet", path(sf, a), "value", u)>
}

void update<sf.name;format="uf">(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <sf.typeInNamespace> const & value) {
    <mutate("updateInMap", "ValueMap", path(sf, a), "value", u)>
}
>>

field_subtract_map_head(sf, a) ::= <%void subtract<sf.name;format="uf">(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, std::set\<<sf.field.keyType>> const & value) {%>

field_xarray(sf, a, u) ::= <<
void insert<sf.name;format="uf">(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, Viper::UUId const & beforePosition, Viper::UUId const & newPosition, <sf.field.elementType><sf.field.passBy> value) {
    mutating->insertInXArray(attachment(), encodeKey(key), <path(sf, a)>,
                            beforePosition, newPosition, <u.model.namespace>::Codec::encode(value));
}

void update<sf.name;format="uf">(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, Viper::UUId const & position, <sf.field.elementType><sf.field.passBy> value) {
    mutating->updateInXArray(attachment(), encodeKey(key), <path(sf, a)>,
                            position, <u.model.namespace>::Codec::encode(value));
}

void remove<sf.name;format="uf">(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, Viper::UUId const & position) {
    mutating->removeInXArray(attachment(), encodeKey(key), <path(sf, a)>, position);
}
>>

// ── et les mêmes quand le document EST l'agrégat ──

document_aggregate(a, u) ::= <<
<if(a.documentType.field.isSet)><a:document_set(u)><elseif(a.documentType.field.isMap)><a:document_map(u)><elseif(a.documentType.field.isXArray)><a:document_xarray(u)><endif>
>>

document_set(a, u) ::= <<
void union_(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <a.documentType.typeInNamespace> const & value) {
    <mutate("unionInSet", "ValueSet", root(), "value", u)>
}

void subtract(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <a.documentType.typeInNamespace> const & value) {
    <mutate("subtractInSet", "ValueSet", root(), "value", u)>
}
>>

document_map(a, u) ::= <<
void union_(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <a.documentType.typeInNamespace> const & value) {
    <mutate("unionInMap", "ValueMap", root(), "value", u)>
}

<document_subtract_map_head(a)>
    <mutate("subtractInMap", "ValueSet", root(), "value", u)>
}

void update(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <a.documentType.typeInNamespace> const & value) {
    <mutate("updateInMap", "ValueMap", root(), "value", u)>
}
>>

document_subtract_map_head(a) ::= <%void subtract(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, std::set\<<a.documentType.field.keyType>> const & value) {%>

document_xarray(a, u) ::= <<
void insert(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, Viper::UUId const & beforePosition, Viper::UUId const & newPosition, <a.documentType.field.elementType><a.documentType.field.passBy> value) {
    mutating->insertInXArray(attachment(), encodeKey(key), <root()>,
                            beforePosition, newPosition, <u.model.namespace>::Codec::encode(value));
}

void update(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, Viper::UUId const & position, <a.documentType.field.elementType><a.documentType.field.passBy> value) {
    mutating->updateInXArray(attachment(), encodeKey(key), <root()>, position, <u.model.namespace>::Codec::encode(value));
}

void remove(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, Viper::UUId const & position) {
    mutating->removeInXArray(attachment(), encodeKey(key), <root()>, position);
}
>>

// UN `>>` DANS LE TEXTE ÉMIS FERME UN CORPS `<<…>>`, et chaque type générique qui traverse
// la sortie en produit un. `<%…%>` prend le texte tel quel, mais supprime aussi les blancs
// de tête -- donc il ne sert que pour la ligne qui contient le `>>`, jamais pour un corps
// indenté. D'où le découpage ci-dessous, qui n'a pas d'autre raison d'être.
encode_key(a, u) ::= <<
/// La clé, encodée. Le cast dit ce que le modèle sait déjà : la clé d'un attachment en est une.
<encode_key_head(a)>
    return Viper::ValueKey::cast(<u.model.namespace>::Codec::encode(key));
}
>>

encode_key_head(a) ::= <%std::shared_ptr\<Viper::ValueKey> encodeKey(<a.keyType.typeInNamespace> const & key) {%>

keys(a, u) ::= <<
<keys_head(a)>
    <keys_result(a)>
    for (Viper::ValueSetIter it{getting->keys(attachment())}; it.hasNext(); it.next())
        result.insert(<decode_call(a.keyType.typeInNamespace, u)>(it.value()));

    return result;
}
>>

keys_head(a) ::= <%std::set\<<a.keyType.typeInNamespace>> keys(std::shared_ptr\<Viper::AttachmentGetting> const & getting) {%>
keys_result(a) ::= <%std::set\<<a.keyType.typeInNamespace>> result;%>

get(a, u) ::= <<
<get_head(a)>
    auto const document = getting->get(attachment(), encodeKey(key));
    if (document->isNil())
        return std::nullopt;

    return <decode_call(a.documentType.typeInNamespace, u)>(document->unwrap());
}
>>

get_head(a) ::= <%std::optional\<<a.documentType.typeInNamespace>> get(std::shared_ptr\<Viper::AttachmentGetting> const & getting, <a.keyType.typeInNamespace> const & key) {%>

decode_call(type, u) ::= <%<u.model.namespace>::Codec::decode\<<type>>%>
