unit(u) ::= <<
// <u.name> — the types this namespace declares.
//
// <u.model.generated>

#ifndef <u.name>_Data_hpp
#define <u.name>_Data_hpp

<u.dependencies.types:{d|#include "<d.include.Data>"};separator="\n">

#include "Viper_AnyConceptKey.hpp"
#include "Viper_Scalars.hpp"
#include "Viper_UUId.hpp"

#include \<array>
#include \<cstdint>
#include \<map>
#include \<set>
#include \<string>
#include \<variant>
#include \<vector>
#include \<functional>
#include \<optional>

namespace <u.name> {

<u.concepts:concept();separator="\n\n">

<u.enumerations:enumeration();separator="\n\n">

<u.structures:structure();separator="\n\n">

} // namespace <u.name>

<u.concepts:key_hash(u);separator="\n">
<u.structures:value_hash(u);separator="\n">

#endif
>>

concept(c) ::= <<
<if(c.documentation)>/** <c.documentation> */
<endif>class <c.name>Key final {
public:
    <c.name>Key() = default;
    <c.name>Key(Viper::UUId const & instanceId, Viper::UUId const & runtimeId) noexcept;

    static <c.name>Key create();

    Viper::UUId const & instanceId() const noexcept;
    Viper::UUId const & runtimeId() const noexcept;

    bool isValid() const noexcept;
<if(c.dsmConcept.parent)>
    /// Widen to the parent concept. Implicit, because `is a` is not a request.
    operator <c.parentNameInNamespace>Key() const noexcept;
<endif>
    Viper::AnyConceptKey toAny() const noexcept;
    static std::optional\<<c.name>Key> from(Viper::AnyConceptKey const & key) noexcept;

    std::size_t hash() const noexcept;

private:
    Viper::UUId _instanceId{};
    Viper::UUId _runtimeId{};
};

bool operator==(<c.name>Key const &, <c.name>Key const &) noexcept;
bool operator!=(<c.name>Key const &, <c.name>Key const &) noexcept;
bool operator\<(<c.name>Key const &, <c.name>Key const &) noexcept;
>>

structure(s) ::= <<
<if(s.documentation)>/** <s.documentation> */
<endif>struct <s.name> final {
<s.fields:field();separator="\n">
};

bool operator==(<s.name> const &, <s.name> const &) noexcept;
bool operator!=(<s.name> const &, <s.name> const &) noexcept;
bool operator\<(<s.name> const &, <s.name> const &) noexcept;

std::size_t hash(<s.name> const & value) noexcept;
>>

field(f) ::= <<    <f.typeInNamespace> <f.name>{};>>

// `enum class` et non `enum` : le scope nomme déjà l'unité, et une énumération non scopée
// verserait ses cases dans le namespace de l'unité, où elles heurteraient les noms des
// autres. Aucune valeur explicite -- ce qui traverse le fil est l'index de la case, et le
// modèle en est la source.
enumeration(e) ::= <<
<if(e.documentation)>/** <e.documentation> */
<endif>enum class <e.name> {
<e.members:enumeration_case();separator=",\n">
};
>>

// Une sous-template nommée, et non `{m|    <m.name>}` : StringTemplate mange une espace
// après le `|`, donc l'indentation sort à trois caractères sans que rien ne le signale.
enumeration_case(m) ::= <<
    <m.name;format="uf">
>>

// The specialisation stands outside the namespace, so the type has to be qualified --
// `std::hash\<ModelA::MaterialKey>`, not `std::hash\<MaterialKey>`. And the two kinds do not
// hash the same way: a key carries its own `hash()`, while a structure is hashed by a free
// function of its namespace, reached the same way every other operation on it is.
//
// `<%…%>` for the opening line only: a `>>` in the emitted text closes a `<<…>>` body, and
// `std::hash\<ModelA::MaterialKey>` ends in one. `<%…%>` also strips leading whitespace,
// which is why the indented line below stays in a `<<…>>` body.
key_hash(c, u) ::= <<
<key_hash_head(c, u)>
    std::size_t operator()(<u.name>::<c.name>Key const & v) const noexcept { return v.hash(); }
};
>>

key_hash_head(c, u) ::= <%template\<> struct std::hash\<<u.name>::<c.name>Key> {%>

value_hash(s, u) ::= <<
<value_hash_head(s, u)>
    std::size_t operator()(<u.name>::<s.name> const & v) const noexcept { return <u.name>::hash(v); }
};
>>

value_hash_head(s, u) ::= <%template\<> struct std::hash\<<u.name>::<s.name>> {%>
