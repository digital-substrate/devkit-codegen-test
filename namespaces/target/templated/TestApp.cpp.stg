// Le programme qui éprouve le modèle.
//
// LE SEUL ARTEFACT QUI ÉNUMÈRE LES UNITÉS, et c'est sa raison d'être. Tout le reste produit
// du code par unité, qui ne connaît que lui-même ; quelqu'un doit dire qu'un modèle est fait
// de celles-ci. C'est un assemblage, donc c'est du socle.
//
// LE PACK EN ÉCRIT QUATRE -- codec, base, base en fuzz, base distante -- qui ne diffèrent que
// par les options acceptées et les appels lancés. Ici il y en a un, parce que ce qu'ils
// lancent est devenu une liste et non sept familles de fonctions.

model(m) ::= <<
// <m.namespace> — le programme qui éprouve le modèle.
//
// <m.generated>

#include "<m.include.Test>"

<m.nameSpaces:{u|#include "<u.include.Test>"};separator="\n">

#include "Viper_Database.hpp"

#include \<cstdlib>
#include \<iostream>
#include \<string>

namespace {

/// Les unités du modèle, dans l'ordre où il les déclare. La seule liste produite à ce
/// niveau -- et la seule chose qu'une unité ne peut pas dire d'elle-même.
void testTypes() {
<m.nameSpaces:call_test();separator="\n">
}

void testDatabase(std::shared_ptr\<Viper::Database> const & db) {
<m.nameSpaces:call_database();separator="\n">
}

} // namespace

int main(int argc, char * argv[]) {
    // Une graine explicite rend la séquence reproductible ; sans elle, chaque exécution
    // éprouve autre chose, ce qui est le but.
    if (argc > 2 && std::string{argv[1]} == "--seed")
        <m.namespace>::Test::seed(std::strtoull(argv[2], nullptr, 10));

    try {
        testTypes();

        auto const db = Viper::Database::createInMemory(<m.namespace>::Codec::definitions());
        testDatabase(db);
        db->close();
    } catch (std::exception const & e) {
        std::cerr \<\< "échec : " \<\< e.what() \<\< std::endl;
        return 1;
    }

    std::cout \<\< "ok" \<\< std::endl;
    return 0;
}
>>

// Une sous-template nommée : StringTemplate mange une espace après le `|` d'une anonyme, et
// l'indentation sortirait à trois caractères sans que rien ne le signale.
call_test(u) ::= <<
    <u.name>::test();
>>

call_database(u) ::= <<
    <u.name>::testDatabase(db);
>>
