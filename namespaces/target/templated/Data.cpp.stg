// L'implémentation des types d'une unité.
//
// L'essentiel est mécanique -- des accesseurs, des comparaisons, une combinaison de
// hachages -- et deux choses ne le sont pas : `from`, qui rétrécit depuis la clé non typée,
// et les getters d'un club. Toutes deux posent la même question, et ni l'une ni l'autre ne
// peut y répondre avec ce que l'unité sait.

unit(u) ::= <<
// unité <u.name> — l'implémentation de ses types.
//
// <u.model.generated>

#include "<u.include.Data>"

#include "<u.include.Model>"
#include "<u.model.include.Codec>"

namespace <u.name> {

<u.concepts:concept(u);separator="\n\n">

<u.clubs:club(u);separator="\n\n">

<u.enumerations:enumeration(u);separator="\n\n">

<u.structures:structure(u);separator="\n\n">

} // namespace <u.name>
>>

concept(c, u) ::= <<
// ── <c.name> ──

<c.name>Key::<c.name>Key(Viper::UUId const & instanceId, Viper::UUId const & runtimeId) noexcept
: _instanceId{instanceId}, _runtimeId{runtimeId} {}

<c.name>Key <c.name>Key::create() { return {Viper::UUId::create(), RuntimeIds::<c.name>}; }

Viper::UUId const & <c.name>Key::instanceId() const noexcept { return _instanceId; }
Viper::UUId const & <c.name>Key::runtimeId() const noexcept { return _runtimeId; }
bool <c.name>Key::isValid() const noexcept { return _instanceId.isValid(); }
<if(c.parent)>

/// L'élargissement ne perd rien et ne peut pas échouer : l'identifiant d'exécution reste
/// celui du concept réel, et c'est pourquoi le retour est possible ensuite.
<c.name>Key::operator <c.parentNameInNamespace>Key() const noexcept { return {_instanceId, _runtimeId}; }
<endif>

<u.model.namespace>::AnyConceptKey <c.name>Key::toAny() const noexcept { return {_instanceId, _runtimeId}; }

<narrowing_doc()>
<from(c, u, "conceptType")>

<comparisons(c)>

<key_hash(c)>
>>

// UN CLUB EST UN RÉTRÉCISSEMENT DE PLUS, ET RIEN D'AUTRE. Entrer est gratuit : un membre
// est membre, donc le constructeur recopie les deux identifiants. Sortir pose la même
// question que `from`, une fois par membre -- et la pose au modèle, avec le descripteur du
// club, parce qu'une adhésion n'est pas un héritage.
club(c, u) ::= <<
// ── <c.name> ──

<c.name>Key::<c.name>Key(Viper::UUId const & instanceId, Viper::UUId const & runtimeId) noexcept
: _instanceId{instanceId}, _runtimeId{runtimeId} {}

<c.membersInNamespace:club_constructor(c);separator="\n\n">

<c.membersInNamespace:club_getter(c);separator="\n\n">

Viper::UUId const & <c.name>Key::instanceId() const noexcept { return _instanceId; }
Viper::UUId const & <c.name>Key::runtimeId() const noexcept { return _runtimeId; }
bool <c.name>Key::isValid() const noexcept { return _instanceId.isValid(); }

<u.model.namespace>::AnyConceptKey <c.name>Key::toAny() const noexcept { return {_instanceId, _runtimeId}; }

<narrowing_doc()>
<from(c, u, "clubType")>

<comparisons(c)>

<key_hash(c)>
>>

club_constructor(cm, c) ::= <<
<c.name>Key::<c.name>Key(<cm.nameInNamespace>Key const & key) noexcept
: _instanceId{key.instanceId()}, _runtimeId{key.runtimeId()} {}
>>

club_getter(cm, c) ::= <<
<club_getter_head(cm, c)>
    return <cm.nameInNamespace>Key::from(toAny());
}
>>

club_getter_head(cm, c) ::= <%std::optional\<<cm.nameInNamespace>Key> <c.name>Key::as<cm.asNameInNamespace>Key() const noexcept {%>

// LE RÉTRÉCISSEMENT NE PEUT PAS S'ÉCRIRE AVEC CE QUE L'UNITÉ SAIT.
//
// Le pack énumère ici les identifiants de tous les dérivés connus à la génération. Dans un
// monde plat cela passe, tout étant dans un fichier. Par unité, non : un dérivé peut vivre
// dans une unité qui dépend de celle-ci, et il faudrait l'inclure -- l'arête à l'envers.
//
// Et ce n'est pas qu'une question de dépendance. Un dérivé peut avoir été déclaré après
// que cette unité a été générée, ce que le pack reconnaît lui-même dans un commentaire :
// l'énumération à la génération est fausse dès qu'un modèle s'étend.
//
// La question porte sur la hiérarchie des concepts du modèle. Elle se pose donc au modèle,
// et se répond à l'exécution.
narrowing_doc() ::= <<
/// Rétrécir depuis la clé non typée : le modèle répond, parce que lui seul connaît la
/// hiérarchie -- y compris ce qui a été déclaré après cette unité.
>>

from(c, u, descriptor) ::= <<
<from_head(c)>
    if (!<u.model.namespace>::Codec::isMember(key, <descriptor>(Viper::Codec::tag\<<c.name>Key>{})))
        return std::nullopt;

    return <c.name>Key{key.instanceId(), key.runtimeId()};
}
>>

from_head(c) ::= <%std::optional\<<c.name>Key> <c.name>Key::from(<u.model.namespace>::AnyConceptKey const & key) noexcept {%>

comparisons(c) ::= <<
bool operator==(<c.name>Key const & l, <c.name>Key const & r) noexcept {
    return l.instanceId() == r.instanceId() && l.runtimeId() == r.runtimeId();
}
bool operator!=(<c.name>Key const & l, <c.name>Key const & r) noexcept { return !(l == r); }
bool operator\<(<c.name>Key const & l, <c.name>Key const & r) noexcept {
    if (l.instanceId() != r.instanceId())
        return l.instanceId() \< r.instanceId();
    return l.runtimeId() \< r.runtimeId();
}
>>

key_hash(c) ::= <<
void hash(Viper::Hash::Accumulator & h, <c.name>Key const & value) noexcept {
    hash(h, value.instanceId());
    hash(h, value.runtimeId());
}
>>

// Une structure se compare et se hache champ par champ, chacun confié à l'unité qui le
// possède : `hash(h, value.x)` part chez le runtime pour un entier et chez une autre unité
// pour une clé étrangère, sans que rien ici ait à le savoir.
structure(s, u) ::= <<
// ── <s.name> ──

bool operator==(<s.name> const & l, <s.name> const & r) noexcept {
    return <s.fields:field_equal();separator="\n        && ">;
}
bool operator!=(<s.name> const & l, <s.name> const & r) noexcept { return !(l == r); }
bool operator\<(<s.name> const & l, <s.name> const & r) noexcept {
<trunc(s.fields):field_less();separator="\n">
    return l.<last(s.fields).name> \< r.<last(s.fields).name>;
}

void hash(Viper::Hash::Accumulator & h, <s.name> const & value) noexcept {
<s.fields:field_hash();separator="\n">
}
>>

// Une énumération se hache par son rang, qui est ce que le modèle ordonne et ce qui
// traverse le fil. La valeur C++ sous-jacente dirait la même chose ici, mais elle n'est
// pas le contrat.
enumeration(e, u) ::= <<
// ── <e.name> ──

void hash(Viper::Hash::Accumulator & h, <e.name> value) noexcept {
    hash(h, static_cast\<std::uint8_t>(value));
}
>>

field_equal(f) ::= <%l.<f.name> == r.<f.name>%>
field_less(f) ::= <<    if (l.<f.name> != r.<f.name>) return l.<f.name> \< r.<f.name>;>>
field_hash(f) ::= <<    hash(h, value.<f.name>);>>
