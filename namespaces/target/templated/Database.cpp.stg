// Cinq renvois par attachment : le corps est celui du socle, instancié sur la clé et le
// document. Ce qui reste propre à l'attachment est son identifiant, déjà déclaré à côté de
// ses opérations en mémoire.

unit(u) ::= <<
// unité <u.name> — l'implémentation, qui est cinq renvois par attachment.
//
// <u.model.generated>

#include "<u.include.Database>"

#include "<u.include.Attachments>"
#include "<u.include.Codec>"
<u.dependencies.attachments:{d|#include "<d.include.Codec>"};separator="\n">

#include "<u.model.include.Db>"

<u.attachments:attachment(u);separator="\n\n">
>>

attachment(a, u) ::= <<
namespace <u.name>::Database::<a.conceptScope>::<a.name> {

namespace {
auto const & attachment() { return <u.name>::Attachments::<a.conceptScope>::<a.name>::runtimeId; }
}

<keys_body(a, u)>

bool has(std::shared_ptr\<Viper::Database const> const & db, <a.keyType.typeInNamespace> const & key) {
    return <u.model.namespace>::Db::has(db, attachment(), key);
}

<get_body(a, u)>

bool set(std::shared_ptr\<Viper::Database> const & db, <a.keyType.typeInNamespace> const & key, <a.documentType.typeInNamespace> const & document) {
    return <u.model.namespace>::Db::set(db, attachment(), key, document);
}

bool del(std::shared_ptr\<Viper::Database> const & db, <a.keyType.typeInNamespace> const & key) {
    return <u.model.namespace>::Db::del(db, attachment(), key);
}

} // namespace <u.name>::Database::<a.conceptScope>::<a.name>
>>

keys_body(a, u) ::= <<
<keys_head(a)>
    <keys_call(a, u)>
}
>>

get_body(a, u) ::= <<
<get_head(a)>
    <get_call(a, u)>
}
>>

keys_head(a) ::= <%std::set\<<a.keyType.typeInNamespace>> keys(std::shared_ptr\<Viper::Database const> const & db) {%>
keys_call(a, u) ::= <%return <u.model.namespace>::Db::keys\<<a.keyType.typeInNamespace>>(db, attachment());%>
get_head(a) ::= <%std::optional\<<a.documentType.typeInNamespace>> get(std::shared_ptr\<Viper::Database const> const & db, <a.keyType.typeInNamespace> const & key) {%>
get_call(a, u) ::= <%return <u.model.namespace>::Db::get\<<a.documentType.typeInNamespace>>(db, attachment(), key);%>
