// Les attachments d'une unité, vus depuis une base de données.
//
// La même portée qu'en mémoire, à un niveau près. Le pack aplatit en
// `DatabaseAttachments::Material_Colour` pour la même raison qu'ailleurs : une portée qui
// n'existait pas.

unit(u) ::= <<
// <u.name> — ses attachments, vus depuis une base de données.
//
// <u.model.generated>

#ifndef <u.name>_Database_hpp
#define <u.name>_Database_hpp

#include "<u.include.Data>"
<u.dependencies.attachments:{d|#include "<d.include.Data>"};separator="\n">

#include "Viper_Database.hpp"

#include \<optional>
#include \<set>

<u.attachments:attachment(u);separator="\n\n">

#endif
>>

attachment(a, u) ::= <<
<if(a.hasDocumentation)>/** <a.documentation> */
<endif>namespace <u.name>::Database::<a.conceptScope>::<a.name> {

<keys(a)>
bool has(std::shared_ptr\<Viper::Database const> const & db, <a.keyType.typeInNamespace> const & key);
<get(a)>
bool set(std::shared_ptr\<Viper::Database> const & db, <a.keyType.typeInNamespace> const & key, <a.documentType.typeInNamespace> const & document);
bool del(std::shared_ptr\<Viper::Database> const & db, <a.keyType.typeInNamespace> const & key);

} // namespace <u.name>::Database::<a.conceptScope>::<a.name>
>>

keys(a) ::= <%std::set\<<a.keyType.typeInNamespace>> keys(std::shared_ptr\<Viper::Database const> const & db);%>
get(a) ::= <%std::optional\<<a.documentType.typeInNamespace>> get(std::shared_ptr\<Viper::Database const> const & db, <a.keyType.typeInNamespace> const & key);%>
