// L'implémentation d'un pool : le pont entre le statique et le dynamique.
//
// UN POOL EST DEUX CHOSES QUI SE RESSEMBLENT. Du côté statique, des fonctions C++ que le
// développeur écrit lui-même -- le générateur n'en produit que la déclaration. Du côté
// dynamique, des `Viper::Function` qui prennent et rendent des `Viper::Value`, parce que
// c'est ainsi qu'un appel arrive d'un script, d'une RPC ou d'un outil.
//
// LE PONT NE CONVERTIT RIEN TYPE À TYPE. Il décode chaque argument depuis sa Value, appelle
// la fonction statique, encode le retour -- et `decode<T>` trouve le `read` de T par ADL,
// sans savoir de quelle unité T vient. Le pack écrit ici un
// `ValueDecoder::decode_ModelA_MaterialKey` par type, des noms plats qui existaient parce
// que rien d'autre ne distinguait les appels.
//
// ET C'EST ICI QUE LE CONTRAT DE FORMAT SE PAIE. `decode<T>` fait passer la Value par un
// flux et relit avec `read` : ce que `Viper::ValueWriter` pose pour cette Value doit être
// exactement ce que `read` attend. Les conteneurs sont des templates du runtime, écrits une
// fois à côté du ValueWriter qu'ils doivent suivre, au lieu d'être ré-émis par forme et par
// modèle -- ce qui rend le contrat vérifiable en un endroit.

pool(p) ::= <<
<preamble(p, "FunctionPool")>

namespace <p.name;format="uf"> {

namespace {

/// L'identité de ce pool dans le modèle, nommée une fois : les deux bords s'en servent.
Viper::UUId const poolId{Viper::UUId::parse("<p.uuid>")};

<p.functions:function(p);separator="\n\n">

} // namespace

std::shared_ptr\<Viper::FunctionPool> pool() {
    static auto const instance = [] {
        auto const created = Viper::FunctionPool::make(poolId, "<p.name>");
<p.functions:function_add();separator="\n">
        return created;
    }();
    return instance;
}

<remote(p)>

} // namespace <p.name;format="uf">
>>

// UN POOL D'ATTACHMENTS AGIT SUR DES DOCUMENTS, PAS SUR DES VALEURS SEULES : sa fonction
// reçoit en plus l'interface sur laquelle agir. C'est la seule différence, et elle est
// dans la signature -- assez pour que les deux entrées restent séparées.
attachment_pool(p) ::= <<
<preamble(p, "AttachmentFunctionPool")>

namespace <p.name;format="uf"> {

namespace {

Viper::UUId const poolId{Viper::UUId::parse("<p.uuid>")};

<p.functions:attachment_function(p);separator="\n\n">

} // namespace

std::shared_ptr\<Viper::AttachmentFunctionPool> pool() {
    static auto const instance = [] {
        auto const created = Viper::AttachmentFunctionPool::make(poolId, "<p.name>");
<p.functions:function_add();separator="\n">
        return created;
    }();
    return instance;
}

} // namespace <p.name;format="uf">
>>

// DE CHAQUE UNITÉ ATTEINTE, TROIS ARTEFACTS ET PAS UN. Les types pour les signatures, le
// codec pour `write`/`read`, l'identité de modèle pour le descripteur que le prototype
// dynamique réclame. L'en-tête du pool n'avait besoin que du premier.
preamble(p, kind) ::= <<
// <p.name> — l'implémentation du pool, et le pont entre le statique et le dynamique.
//
// <p.model.generated>

#include "<p.include.Pool>"

<p.dependencies.functions:{d|#include "<d.include.Codec>"};separator="\n">
<p.dependencies.functions:{d|#include "<d.include.Model>"};separator="\n">

#include "<p.model.include.Codec>"

#include "Viper_<kind>.hpp"
#include "Viper_ServiceRemote.hpp"
>>

function(f, p) ::= <<
/// `<f.name;format="lsc">`, vue du dynamique.
class <f.name;format="uf"> final : public Viper::Function {
public:
    <make(f)>

    explicit <f.name;format="uf">(std::shared_ptr\<Viper::FunctionPrototype> prototype)
    : Viper::Function{std::move(prototype)} {}

protected:
    <checked_call(f)>
<if(f.parameters)>
<f.parameters:{a|<a:decode(p, i0)>};separator="\n">

<endif>
<if(f.isVoid)>
        <f.name;format="lsc">(<f.parameters:{a|<a.name>};separator=", ">);
        return Viper::Void::Instance();
<else>
        return <p.model.namespace>::Codec::encode(<f.name;format="lsc">(<f.parameters:{a|<a.name>};separator=", ">));
<endif>
    }
};
>>

attachment_function(f, p) ::= <<
/// `<f.name;format="lsc">`, vue du dynamique.
class <f.name;format="uf"> final : public Viper::Attachment<f.interfaceType>Function {
public:
    <make(f)>

    explicit <f.name;format="uf">(std::shared_ptr\<Viper::FunctionPrototype> prototype)
    : Viper::Attachment<f.interfaceType>Function{std::move(prototype)} {}

    std::string representation() const override { return "<f.name;format="lsc">"; }

protected:
    <attachment_checked_call(f)>
<if(f.parameters)>
<f.parameters:{a|<a:decode(p, i0)>};separator="\n">

<endif>
<if(f.isVoid)>
        <f.name;format="lsc">(attachment<f.interfaceType><if(f.parameters)>, <f.parameters:{a|<a.name>};separator=", "><endif>);
        return Viper::Void::Instance();
<else>
        return <p.model.namespace>::Codec::encode(<f.name;format="lsc">(attachment<f.interfaceType><if(f.parameters)>, <f.parameters:{a|<a.name>};separator=", "><endif>));
<endif>
    }
};
>>

// Les arguments sont décodés dans l'ordre du prototype, et c'est le seul endroit où
// l'ordre compte : une Value ne porte pas le nom du paramètre.
decode(a, p, i) ::= <<
        <decode_body(a, p, i)>
>>
decode_body(a, p, i) ::= <%auto const <a.name>{<p.model.namespace>::Codec::decode\<<a.type>>(args.at(<i>))};%>

make(f) ::= <<
<make_head(f)>
    <make_body(f)>
        "<f.name;format="lsc">",
        {<f.parameters:parameter();separator=",\n         ">},
        <return_type(f)>));
}
>>

make_head(f) ::= <%static std::shared_ptr\<<f.name;format="uf">> make() {%>
make_body(f) ::= <%return std::make_shared\<<f.name;format="uf">>(Viper::FunctionPrototype::make(%>

parameter(a) ::= <%{"<a.name>", type(Viper::Codec::tag\<<a.type>>{})}%>
return_type(f) ::= <%<if(f.isVoid)>Viper::TypeVoid::Instance()<else>type(Viper::Codec::tag\<<f.type>>{})<endif>%>

// CHAQUE LIGNE QUI ÉMET UN `>>` SORT D'UN `<%…%>`. Ici il y en a partout --
// `shared_ptr<Value>>`, `decode<T>` -- et un `>>` dans un corps `<<…>>` le ferme là, sans
// rien dire : le fichier rendu s'arrête au milieu d'une signature et les sous-templates
// suivantes deviennent introuvables. Le diagnostic nomme les disparues, jamais la cause.
checked_call(f) ::= <<
<checked_call_head()>
        <checked_call_args()>
>>

checked_call_head() ::= <%std::shared_ptr\<Viper::Value> checkedCall(%>
checked_call_args() ::= <%std::vector\<std::shared_ptr\<Viper::Value>> const & args) const override {%>

attachment_checked_call(f) ::= <<
<checked_call_head()>
        <attachment_checked_call_interface(f)>
        <attachment_checked_call_args()>
>>

attachment_checked_call_interface(f) ::= <%std::shared_ptr\<Viper::Attachment<f.interfaceType>> const & attachment<f.interfaceType>,%>
attachment_checked_call_args() ::= <%std::vector\<std::shared_ptr\<Viper::Value>> const & args) const {%>

function_add(f) ::= <<        created->add(<f.name;format="uf">::make());>>

// LE MIROIR EXACT DU PONT. Là où `checkedCall` décode ses arguments et encode son retour,
// `Remote` encode ses arguments et décode son retour : les deux sens du même passage, les
// deux mêmes génériques, et le même contrat de format -- l'appel traverse un processus.
remote(p) ::= <<
Remote::Remote(std::shared_ptr\<Viper::ServiceRemote> service)
: _service{std::move(service)} {}

bool Remote::isAvailable() const {
    return _service->queryFunctionPool(poolId) != nullptr;
}

<p.functions:remote_call(p);separator="\n\n">
>>

remote_call(f, p) ::= <<
<remote_head(f)>
<if(f.isVoid)>
    _service->call(poolId, "<f.name;format="lsc">", {<f.parameters:{a|<p.model.namespace>::Codec::encode(<a.name>)};separator=", ">});
<else>
    <remote_decode(f, p)>
        _service->call(poolId, "<f.name;format="lsc">", {<f.parameters:{a|<p.model.namespace>::Codec::encode(<a.name>)};separator=", ">}));
<endif>
}
>>

remote_decode(f, p) ::= <%return <p.model.namespace>::Codec::decode\<<f.type>>(%>
remote_head(f) ::= <%<if(f.isVoid)>void<else><f.type><endif> Remote::<f.name;format="lsc">(<f.parameters:remote_param();separator=", ">) const {%>
remote_param(a) ::= <%<a.type><a.passBy> <a.name>%>
