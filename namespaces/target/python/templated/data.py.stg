// Les types que déclare une unité, et rien d'autre.
//
// UNE CLASSE GÉNÉRÉE ENVELOPPE UNE `dsviper.Value`, ELLE NE LA COPIE PAS. C'est le choix du
// runtime et non une transposition du C++ : la donnée vit dans la Value, la classe lui donne
// des noms. Il n'y a donc rien à sérialiser -- la valeur est déjà ce que le runtime écrit --
// et pas de couche codec à produire.
//
// ET LES CHAMPS SONT DES PROPRIÉTÉS, ce qui fait disparaître la couche 2 du C++. Là-bas il
// fallait `Fields::Colour::r` pour nommer un champ et `rPath()` pour l'adresser, deux
// artefacts en bijection ; `colour.r` est déjà les deux.

unit(u) ::= <<
# <u.model.generated>

"""<u.name> — les types que ce namespace déclare."""

from __future__ import annotations

import enum
import functools
import typing

import dsviper

from .. import definitions
from .._codegen import AnyConceptKey, Mapping, Ordered, Proxy, Sequence, register, unwrap, wrap
<u.dependencies.types:{d|from .. import <d.name;format="lsc">};separator="\n">

# ── l'identité de cette unité dans le modèle ──
#
# LE MÊME ARTEFACT QU'EN C++, POUR LA MÊME RAISON : plusieurs couches en ont besoin et ce
# n'est pas de la sérialisation. Il tient ici en une constante par type, parce qu'il n'y a
# pas de tag à porter — l'appelant nomme la classe.

<u.concepts:runtime_id();separator="\n">
<u.clubs:runtime_id();separator="\n">
<u.enumerations:runtime_id();separator="\n">
<u.structures:runtime_id();separator="\n">

<if(u.concepts)><u.concepts:concept(u);separator="\n\n\n">

<endif>
<if(u.clubs)><u.clubs:club(u);separator="\n\n\n">

<endif>
<if(u.enumerations)><u.enumerations:enumeration(u);separator="\n\n\n">

<endif>
<if(u.structures)><u.sortedStructures:structure(u);separator="\n\n\n">

<endif>

# Les classes de cette unité, par l'identifiant d'exécution de leur type : c'est ce qui
# permet à `wrap` de rendre un élément de conteneur avec son nom, sans qu'aucune classe de
# conteneur existe.
register({<u.concepts:registered_key();separator=", "><if(u.clubs)>, <u.clubs:registered_key();separator=", "><endif><if(u.enumerations)>, <u.enumerations:registered();separator=", "><endif><if(u.structures)>, <u.structures:registered();separator=", "><endif>})

__all__ = [<u.concepts:exported_key();separator=", "><if(u.clubs)>, <u.clubs:exported_key();separator=", "><endif><if(u.enumerations)>, <u.enumerations:exported();separator=", "><endif><if(u.structures)>, <u.structures:exported();separator=", "><endif>]
>>

runtime_id(v) ::= <%<v.name;format="usc">: dsviper.ValueUUId = dsviper.ValueUUId.create("<v.runtimeId>")%>
exported(v) ::= <%"<v.name>"%>
exported_key(v) ::= <%"<v.name>Key"%>

// UNE CLÉ EST UNE POIGNÉE, PAS LA CHOSE. Un club se déclare exactement pareil : les deux
// enveloppent un `ValueKey` et ne diffèrent que par ce qu'ils acceptent, question que le
// runtime tranche sur le descripteur et non le code généré.
concept(c, u) ::= <<
<key(c, u, "concept")>
>>

// UN CLUB EST UN ENSEMBLE NOMMÉ DE CONCEPTS, et sa clé peut désigner une instance de
// n'importe lequel. LE PACK ÉMET UN ACCESSEUR PAR MEMBRE ; ici il n'en faut aucun, parce
// que le runtime répond déjà à la question : `ValueKey.is_member(concept)` et
// `to_member_key(concept)` la posent au descripteur, qui la connaît. Un `as_(cls)` générique
// dit la même chose pour tous les membres, et pour ceux qu'un modèle ajoutera ensuite.
club(c, u) ::= <<
<if(c.hasDocumentation)>
<endif>
class <c.name>Key(Proxy):
    """Une poignée sur une instance d'un membre de <u.name>::<c.name>.
<if(c.hasDocumentation)>

    <c.documentation>
<endif>

    ON N'Y CRÉE PAS D'INSTANCE : un club n'est pas un concept, rien n'est « un Klub ». On y
    entre depuis la clé d'un membre, et on en sort en demandant si c'en est un. Le pack
    donne à la clé de club un `create()` qui passe le descripteur du club là où le runtime
    attend celui d'un concept ; c'est un vérificateur de types qui l'a dit.
    """

    __slots__ = ()

    @classmethod
    @functools.cache
    def club(cls) -> dsviper.TypeClub:
        """Le descripteur du club, résolu une fois."""
        return definitions().check_club(<c.name;format="usc">)

    @classmethod
    @functools.cache
    def type(cls) -> dsviper.Type:
        return dsviper.TypeKey(cls.club())

    def __init__(self, key):
        value = key.value if isinstance(key, Proxy) else key
        if not isinstance(value, dsviper.ValueKey):
            raise TypeError("cette valeur n'est pas une clé")
        if not self.club().is_member(value.type_concept()):
            raise TypeError("cette clé ne désigne pas un membre de <u.name>::<c.name>")
        super().__init__(value.to_club_key(self.club()))

    @property
    def instance_id(self) -> dsviper.ValueUUId:
        return self.value.instance_id()

    def is_valid(self) -> bool:
        return self.instance_id.is_valid()

    def as_(self, cls):
        """La clé vue comme celle d'un membre, ou `None` si l'instance n'en est pas un."""
        concept = cls.concept()
        return cls(self.value.to_member_key(concept)) if self.value.is_member(concept) else None

    def __repr__(self) -> str:
        return f"<u.name>::<c.name>Key({self.value.representation()})"
>>

key(c, u, kind) ::= <<
class <c.name>Key(Proxy):
    """Une poignée sur une instance de <u.name>::<c.name>, pas la chose elle-même.
<if(c.hasDocumentation)>

    <c.documentation>
<endif>
    """

    __slots__ = ()

    @classmethod
    @functools.cache
    def concept(cls):
        """Le descripteur, résolu une fois."""
        return definitions().check_<kind>(<c.name;format="usc">)

    @classmethod
    @functools.cache
    def type(cls) -> dsviper.Type:
        """Le descripteur du type de la clé.

        `classmethod` et non fonction libre : en C++ il fallait `type(tag\<T>{})` pour que la
        recherche par argument trouve l'unité de T. Python n'a pas cette recherche et n'en a
        pas besoin — l'appelant écrit déjà le nom de la classe.
        """
        return dsviper.TypeKey(cls.concept())

    def __init__(self, identifier: dsviper.ValueKey | dsviper.ValueUUId | str | None = None):
        if isinstance(identifier, dsviper.ValueKey):
            if identifier.type() != self.type():
                raise TypeError("cette valeur n'est pas un <u.name>::<c.name>Key")
            super().__init__(identifier)
        else:
            super().__init__(dsviper.ValueKey.create(self.concept(), identifier))

    @classmethod
    def create(cls) -> <c.name>Key:
        """Une clé sur une instance neuve. L'instance n'existe pas tant que rien ne l'écrit."""
        return cls(dsviper.ValueUUId.create())

    @property
    def instance_id(self) -> dsviper.ValueUUId:
        return self.value.instance_id()

    def is_valid(self) -> bool:
        return self.instance_id.is_valid()

    def __repr__(self) -> str:
        return f"<u.name>::<c.name>Key({self.value.representation()})"
>>

// UNE ÉNUMÉRATION N'EST PAS UN PROXY. Python en a une, et le runtime sait convertir depuis
// son nom : une classe qui enveloppe une Value n'apporterait que du poids. Ce qui est généré
// est donc l'énumération Python, plus la fonction qui rend le descripteur.
enumeration(e, u) ::= <<
class <e.name>(enum.Enum):
    """<u.name>::<e.name>.
<if(e.hasDocumentation)>

    <e.documentation>
<endif>

    UNE ÉNUMÉRATION PYTHON, PAS UN PROXY. Le pack en fait une classe qui enveloppe une
    `ValueEnumeration` ; Python en a une, et le runtime sait convertir depuis le nom d'un
    cas. Envelopper n'apporterait que du poids — et `Finish.matte` se lit mieux que
    `Finish("matte")`.
    """

<e.members:enumeration_case();separator="\n">

    @classmethod
    @functools.cache
    def type(cls) -> dsviper.TypeEnumeration:
        return definitions().check_enumeration(<e.name;format="usc">)

    @classmethod
    def _wrap(cls, value) -> <e.name>:
        return cls(value.name())

    def _unwrap(self) -> str:
        return self.value
>>

enumeration_case(c) ::= <<    <c.name> = "<c.name>">>

structure(s, u) ::= <<
class <s.name>(Proxy):
    """<u.name>::<s.name>.
<if(s.hasDocumentation)>

    <s.documentation>
<endif>
    """

    __slots__ = ()

    @classmethod
    @functools.cache
    def type(cls) -> dsviper.TypeStructure:
        return definitions().check_structure(<s.name;format="usc">)

    def __init__(self, value: dsviper.ValueStructure | None = None, /, **fields):
        if value is None:
            value = dsviper.ValueStructure(self.type())
        elif value.type() != self.type():
            raise TypeError("cette valeur n'est pas un <u.name>::<s.name>")
        super().__init__(value)

        for name, field in fields.items():
            setattr(self, name, field)

<s.fields:field(s);separator="\n\n">

    def __repr__(self) -> str:
        return f"<u.name>::<s.name>(<s.fields:repr_field();separator=", ">)"
>>

// LE CHAMP EST UNE PROPRIÉTÉ, ET C'EST TOUT CE QU'IL EST. Le runtime décode la Value en
// objet Python ; il n'y a de conversion à écrire que pour les types qui ont une classe.
field(f, s) ::= <<
    @property
    def <f.name>(self) -> <hint(f)>:
        <read(f)>

    @<f.name>.setter
    def <f.name>(self, value: <hint(f)>) -> None:
        <write(f)>
>>

// UN SEUL PASSAGE POUR TOUT CE QUI N'EST PAS UN PRIMITIF. `wrap` lit le type que la valeur
// porte et rend la classe qui va avec, ou une vue qui enveloppe ses éléments ; il n'y a donc
// pas à distinguer ici une structure d'un `vector<Colour>`, et aucune classe de conteneur
// n'a à être générée. `unwrap` fait le chemin inverse et accepte aussi bien une classe qu'une
// liste Python.
read(f) ::= <%<if(f.bindingType.useProxy)>return wrap(self.value.at("<f.name>", encoded=False))<else>return self.value.at("<f.name>")<endif>%>
write(f) ::= <%self.value.set("<f.name>", <if(f.bindingType.useProxy)>unwrap(value)<else>value<endif>)%>
repr_field(f) ::= <%<f.name>={self.<f.name>}%>

// L'ANNOTATION EST LA FORME ENTIÈRE, ET LE MODÈLE LA DONNE. `Sequence[Colour]`,
// `MaterialKey | None`, `Mapping[MaterialKey, MaterialKey]` : le pack obtient la même chose
// en émettant une classe par combinaison, ici les vues sont génériques et la combinaison
// s'écrit. Une annotation qui s'arrêterait à « un conteneur » rendrait le vérificateur
// aveugle -- `Any` accepte toute affectation, donc un champ de couleurs prendrait un entier
// sans un mot.
hint(f) ::= <%<f.bindingType.annotation>%>

registered(v) ::= <%<v.name;format="usc">: <v.name>%>
registered_key(v) ::= <%<v.name;format="usc">: <v.name>Key%>
