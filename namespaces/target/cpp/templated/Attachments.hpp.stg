unit(u) ::= <<
// unité <u.name> — les données accrochées aux concepts qu'elle déclare.
//
// <u.model.generated>
//
// One scope per attachment, under the concept it is keyed on. The concept's own unit is
// part of the scope name whenever it is not this one: a namespace level cannot hold a
// qualified name, so `ModelA::Material` becomes `ModelA_Material` there -- and always,
// not only when two attachments would otherwise collide, so that adding one never
// renames another.

#ifndef <u.name>_Attachments_hpp
#define <u.name>_Attachments_hpp

#include "<u.include.Data>"
<u.dependencies.attachments:{d|#include "<d.include.Data>"};separator="\n">

#include "Viper_Attachment.hpp"
#include "Viper_AttachmentGetting.hpp"
#include "Viper_Database.hpp"
#include "Viper_AttachmentMutating.hpp"
#include "Viper_UUId.hpp"

#include \<map>

#include \<cstdint>
#include \<optional>
#include \<set>

<u.attachments:attachment(u);separator="\n\n">

#endif
>>

// LA SURFACE EST CELLE DU RUNTIME. Viper::AttachmentMutating offre set, diff et update,
// et rien qui retire un document -- le premier jet déclarait un `remove` qui n'existe
// nulle part. Ce que update permet de plus, c'est d'écrire un champ plutôt que le document
// entier, et cela donne un setter par champ : lier le chemin et le type du champ dans une
// même signature est ce qui rend le chemin sûr.
//
// `/** */` et non `///` : une documentation du modèle tient sur plusieurs lignes, et `///`
// ne commente que la première -- le reste part dans le code. Un bloc le supporte sans que
// le modèle ait à découper quoi que ce soit.
attachment(a, u) ::= <<
<if(a.hasDocumentation)>/** <a.documentation> */
<endif>namespace <u.name>::Attachments::<a.conceptScope>::<a.name> {

/// L'identité de cet attachment dans le modèle. La portée nomme déjà l'attachment, donc
/// il ne reste que le nom.
extern Viper::UUId const runtimeId;

/// Et le descripteur que le runtime en tire, résolu une fois.
///
/// PUBLIC PARCE QUE TOUT LE MONDE LE DEMANDE. L'épreuve sur base et le pont dynamique le
/// veulent autant que les cinq opérations, et chacun le re-résoudrait depuis l'identifiant.
/// Une identité, un endroit.
std::shared_ptr\<Viper::Attachment> const & descriptor();

<keys(a)>

bool has(std::shared_ptr\<Viper::AttachmentGetting> const & getting, <a.keyType.typeInNamespace> const & key);

<get(a)>

void set(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <a.documentType.typeInNamespace> const & value);

void diff(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <a.documentType.typeInNamespace> const & value,
          bool recursive = false);

// ── et les mêmes, sur une base de données ──
//
// DEUX OPÉRATIONS, ET NON CINQ. `Viper::Database` hérite d'`AttachmentGetting`, donc les
// `keys`, `has` et `get` ci-dessus marchent déjà sur une base : ce sont les mêmes fonctions
// virtuelles. Ce qu'une base ajoute est d'écrire en rendant un statut, parce qu'un
// enregistrement peut échouer là où un changement en mémoire ne le peut pas.

bool set(std::shared_ptr\<Viper::Database> const & db, <a.keyType.typeInNamespace> const & key, <a.documentType.typeInNamespace> const & value);
bool del(std::shared_ptr\<Viper::Database> const & db, <a.keyType.typeInNamespace> const & key);
<if(a.documentType.isStructure)>

<a.documentType.structure.fields:field(a);separator="\n">
<elseif(a.documentType.field.isNotBox)>

<a:document_aggregate()>
<endif>

} // namespace <u.name>::Attachments::<a.conceptScope>::<a.name>
>>

/// Un setter par champ du document -- l'unique consommateur des chemins de la couche 2.
///
/// ET LES MUTATIONS D'AGRÉGAT QUAND LE CHAMP EN EST UN. `set` remplace le champ ; celles-ci
/// ajoutent, retirent ou déplacent à l'intérieur, et deux écritures concurrentes sur le
/// même ensemble se fondent là où deux remplacements s'écrasent.
///
/// LE NOM PORTE LE CHAMP. Un document peut avoir plusieurs champs agrégés, et `union_` ne
/// dirait pas lequel. C'est l'aplatissement contraint : une portée par champ ajouterait un
/// quatrième niveau sous l'attachment.
field(sf, a) ::= <<
void set<sf.name;format="uf">(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <sf.typeInNamespace><sf.passBy> value);
<if(sf.field.isSet)><sf:field_set(a)><elseif(sf.field.isMap)><sf:field_map(a)><elseif(sf.field.isXArray)><sf:field_xarray(a)><endif>
>>

field_set(sf, a) ::= <<
void union<sf.name;format="uf">(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <sf.typeInNamespace> const & value);
<field_subtract_set(sf, a)>
>>

field_map(sf, a) ::= <<
void union<sf.name;format="uf">(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <sf.typeInNamespace> const & value);
<field_subtract_map(sf, a)>
void update<sf.name;format="uf">(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <sf.typeInNamespace> const & value);
>>

field_xarray(sf, a) ::= <<
void insert<sf.name;format="uf">(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, Viper::UUId const & beforePosition, Viper::UUId const & newPosition, <sf.field.elementType><sf.field.passBy> value);
void update<sf.name;format="uf">(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, Viper::UUId const & position, <sf.field.elementType><sf.field.passBy> value);
void remove<sf.name;format="uf">(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, Viper::UUId const & position);
>>

// Retirer d'une map, c'est retirer des clés : l'argument est un ensemble de clés et non une
// map -- demander les valeurs pour effacer laisserait croire qu'elles comptent.
field_subtract_set(sf, a) ::= <%void subtract<sf.name;format="uf">(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <sf.typeInNamespace> const & value);%>
field_subtract_map(sf, a) ::= <%void subtract<sf.name;format="uf">(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, std::set\<<sf.field.keyType>> const & value);%>

// ── et les mêmes quand le document EST l'agrégat ──
//
// `union_` et non `union`, qui est un mot du langage. L'adresse est la racine au lieu de
// celle d'un champ, et c'est la seule différence entre les deux familles.
document_aggregate(a) ::= <<
<if(a.documentType.field.isSet)><a:document_set()><elseif(a.documentType.field.isMap)><a:document_map()><elseif(a.documentType.field.isXArray)><a:document_xarray()><endif>
>>

document_set(a) ::= <<
void union_(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <a.documentType.typeInNamespace> const & value);
void subtract(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <a.documentType.typeInNamespace> const & value);
>>

document_map(a) ::= <<
void union_(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <a.documentType.typeInNamespace> const & value);
<document_subtract_map(a)>
void update(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, <a.documentType.typeInNamespace> const & value);
>>

document_subtract_map(a) ::= <%void subtract(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, std::set\<<a.documentType.field.keyType>> const & value);%>

document_xarray(a) ::= <<
void insert(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, Viper::UUId const & beforePosition, Viper::UUId const & newPosition, <a.documentType.field.elementType><a.documentType.field.passBy> value);
void update(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, Viper::UUId const & position, <a.documentType.field.elementType><a.documentType.field.passBy> value);
void remove(std::shared_ptr\<Viper::AttachmentMutating> const & mutating, <a.keyType.typeInNamespace> const & key, Viper::UUId const & position);
>>


// `<%…%>`, because a `>>` in the emitted text would close a `<<…>>` body. Every generic
// type crossing into the output hits this.
keys(a) ::= <%std::set\<<a.keyType.typeInNamespace>> keys(std::shared_ptr\<Viper::AttachmentGetting> const & getting);%>
get(a) ::= <%std::optional\<<a.documentType.typeInNamespace>> get(std::shared_ptr\<Viper::AttachmentGetting> const & getting, <a.keyType.typeInNamespace> const & key);%>
