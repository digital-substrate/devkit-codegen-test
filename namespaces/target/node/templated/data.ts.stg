// Les types que déclare une unité, et rien d'autre.
//
// UNE CLASSE GÉNÉRÉE ENVELOPPE UNE `dsviper.Value`, ELLE NE LA COPIE PAS. La donnée vit dans
// la Value, la classe lui donne des noms. Il n'y a donc rien à sérialiser -- la valeur est
// déjà ce que le runtime écrit -- et pas de couche codec à produire.
//
// ET LES CHAMPS SONT DES ACCESSEURS, ce qui fait disparaître la couche 2 du C++ : là-bas il
// fallait `Fields::Colour::r` pour nommer un champ et `rPath()` pour l'adresser ; `colour.r`
// est déjà les deux.

unit(u) ::= <<
// <u.model.generated>

/** <u.name> — les types que ce namespace déclare. */
import dsviper from "@digitalsubstrate/dsviper";

import { Mapping, Ordered, Sequence } from "../_codegen/container.js";
import { Proxy } from "../_codegen/proxy.js";
import { AnyConceptKey, isKnown, register, setField, wrap } from "../_codegen/registry.js";
import { definitions } from "../index.js";
<u.dependencies.types:{d|import * as <d.name;format="lsc"> from "../<d.name;format="lsc">/data.js";};separator="\n">

// ── l'identité de cette unité dans le modèle ──
//
// LE MÊME ARTEFACT QU'EN C++ ET EN PYTHON, POUR LA MÊME RAISON : plusieurs couches en ont
// besoin et ce n'est pas de la sérialisation.

<u.concepts:runtime_id();separator="\n">
<u.clubs:runtime_id();separator="\n">
<u.enumerations:runtime_id();separator="\n">
<u.structures:runtime_id();separator="\n">
<if(u.concepts)>

<u.concepts:concept(u);separator="\n\n">
<endif>
<if(u.clubs)>

<u.clubs:club(u);separator="\n\n">
<endif>
<if(u.enumerations)>

<u.enumerations:enumeration(u);separator="\n\n">
<endif>
<if(u.structures)>

<u.sortedStructures:structure(u);separator="\n\n">
<endif>

// Les classes de cette unité, par l'identifiant d'exécution de leur type : c'est ce qui permet
// à `wrap` de rendre un élément de conteneur, ou un document d'attachment, avec son nom.
register(<u.concepts:registered_key();separator=", "><if(u.clubs)>, <u.clubs:registered_key();separator=", "><endif><if(u.enumerations)>, <u.enumerations:registered();separator=", "><endif><if(u.structures)>, <u.structures:registered();separator=", "><endif>);
>>

runtime_id(v) ::= <%export const <v.name;format="usc"> = dsviper.ValueUUId.create("<v.runtimeId>");%>
registered(v) ::= <%[<v.name;format="usc">, <v.name>]%>
registered_key(v) ::= <%[<v.name;format="usc">, <v.name>Key]%>

// UNE CLÉ EST UNE POIGNÉE, PAS LA CHOSE.
concept(c, u) ::= <<
let <c.name;format="lsc">Concept: dsviper.TypeConcept | undefined;
let <c.name;format="lsc">Type: dsviper.TypeKey | undefined;

/**
 * Une poignée sur une instance de <u.name>::<c.name>, pas la chose elle-même.
<if(c.hasDocumentation)>
 *
 * <c.documentation>
<endif>
 */
export class <c.name>Key extends Proxy\<dsviper.ValueKey> {
    static concept(): dsviper.TypeConcept {
        return (<c.name;format="lsc">Concept ??= definitions().checkConcept(<c.name;format="usc">));
    }

    /**
     * Le descripteur du type de la clé, résolu une fois.
     *
     * STATIQUE ET NON LIBRE : en C++ il fallait `type(tag\<T>{})` pour que la recherche par
     * argument trouve l'unité de T. TypeScript n'a pas cette recherche et n'en a pas besoin --
     * l'appelant écrit déjà le nom de la classe.
     */
    static type(): dsviper.TypeKey {
        return (<c.name;format="lsc">Type ??= new dsviper.TypeKey(<c.name>Key.concept()));
    }

    constructor(identifier?: dsviper.ValueKey | dsviper.ValueUUId) {
        if (identifier instanceof dsviper.ValueKey) {
            if (!identifier.type().equals(<c.name>Key.type())) {
                throw new TypeError("cette valeur n'est pas un <u.name>::<c.name>Key");
            }
            super(identifier);
        } else {
            super(dsviper.ValueKey.create(<c.name>Key.concept(), identifier));
        }
    }

    /** Une clé sur une instance neuve. L'instance n'existe pas tant que rien ne l'écrit. */
    static create(): <c.name>Key {
        return new <c.name>Key(dsviper.ValueUUId.create());
    }

    static wrap(value: dsviper.Value): <c.name>Key {
        return new <c.name>Key(dsviper.ValueKey.cast(value));
    }

    static decode(blob: dsviper.ValueBlob): <c.name>Key {
        return new <c.name>Key(dsviper.ValueKey.cast(
            dsviper.Value.decode(blob, <c.name>Key.type(), definitions())));
    }

    instanceId(): dsviper.ValueUUId {
        return this.value.instanceId();
    }

    runtimeId(): dsviper.ValueUUId {
        return this.value.typeConcept().runtimeId();
    }

    isValid(): boolean {
        return this.value.instanceId().isValid();
    }

    /** L'instance et son type, dits comme le modèle les nomme. */
    description(): string {
        return `${this.value.instanceId().encoded()}:<u.name>::<c.name>Key`;
    }

    isKnown(): boolean {
        return isKnown(this.value);
    }

<if(c.parent)>
    /** Élargir vers le parent. Ne perd rien : l'identifiant d'exécution reste celui du concept
     *  réel, et c'est ce qui permet d'en revenir ensuite. */
    toParentKey(): <c.parentBindingInNamespace> {
        return new <c.parentBindingInNamespace>(this.value);
    }

<endif>
    /** La clé, vue sans son type. */
    toAnyConceptKey(): AnyConceptKey {
        return new AnyConceptKey(this.value.toAnyConceptKey());
    }

    /** La clé non typée, retypée — ou `undefined` si elle ne désigne pas ce concept.
     *
     * LE CHEMIN DE RETOUR, ET IL PEUT ÉCHOUER. Élargir ne perd rien ; rétrécir pose une
     * question dont la réponse est dans l'identifiant que la valeur porte.
     */
    static fromAnyConceptKey(key: AnyConceptKey | dsviper.ValueKey): <c.name>Key | undefined {
        const value = key instanceof AnyConceptKey ? key.value : key;
        return value.typeConcept().runtimeId().equals(<c.name;format="usc">)
            ? new <c.name>Key(value) : undefined;
    }

    override toString(): string {
        return this.description();
    }
}
>>

// UN CLUB EST UN ENSEMBLE NOMMÉ DE CONCEPTS. ON N'Y CRÉE PAS D'INSTANCE : rien n'est « un
// Klub ». On y entre depuis la clé d'un membre, et on en sort en demandant si c'en est un --
// question que le runtime pose au descripteur, donc aucun accesseur par membre n'est généré.
club(c, u) ::= <<
let <c.name;format="lsc">Club: dsviper.TypeClub | undefined;
let <c.name;format="lsc">Type: dsviper.TypeKey | undefined;

/** Une poignée sur une instance d'un membre de <u.name>::<c.name>. */
export class <c.name>Key extends Proxy\<dsviper.ValueKey> {
    static club(): dsviper.TypeClub {
        return (<c.name;format="lsc">Club ??= definitions().checkClub(<c.name;format="usc">));
    }

    static type(): dsviper.TypeKey {
        return (<c.name;format="lsc">Type ??= new dsviper.TypeKey(<c.name>Key.club()));
    }

    constructor(key: Proxy\<dsviper.ValueKey> | dsviper.ValueKey) {
        const value = key instanceof Proxy ? key.value : key;
        if (!<c.name>Key.club().isMember(value.typeConcept())) {
            throw new TypeError("cette clé ne désigne pas un membre de <u.name>::<c.name>");
        }
        super(value.toClubKey(<c.name>Key.club()));
    }

    static wrap(value: dsviper.Value): <c.name>Key {
        return new <c.name>Key(dsviper.ValueKey.cast(value));
    }

    static decode(blob: dsviper.ValueBlob): <c.name>Key {
        return new <c.name>Key(dsviper.ValueKey.cast(
            dsviper.Value.decode(blob, <c.name>Key.type(), definitions())));
    }

    instanceId(): dsviper.ValueUUId {
        return this.value.instanceId();
    }

    runtimeId(): dsviper.ValueUUId {
        return this.value.typeConcept().runtimeId();
    }

    isValid(): boolean {
        return this.value.instanceId().isValid();
    }

    description(): string {
        return `${this.value.instanceId().encoded()}:<u.name>::<c.name>Key`;
    }

    isKnown(): boolean {
        return isKnown(this.value);
    }

    /** La clé vue comme celle d'un membre, ou `undefined` si l'instance n'en est pas un. */
<c.membersInNamespace:club_from(c);separator="\n\n">

<c.membersInNamespace:club_to(c);separator="\n\n">

    as\<K>(member: { concept(): dsviper.TypeConcept; wrap(value: dsviper.Value): K }): K | undefined {
        const concept = member.concept();
        return this.value.isMember(concept) ? member.wrap(this.value.toMemberKey(concept)) : undefined;
    }

    override toString(): string {
        return this.description();
    }
}
>>

// UNE ÉNUMÉRATION EST UN TYPE UNION, PAS UNE CLASSE. Le pack en fait un proxy qui enveloppe
// une `ValueEnumeration` ; TypeScript a des types littéraux, et le runtime convertit depuis le
// nom d'un cas. `Finish.matte` se lit mieux que `new Finish("matte")`, et l'union se vérifie.
enumeration(e, u) ::= <<
let <e.name;format="lsc">Type: dsviper.TypeEnumeration | undefined;

/** <u.name>::<e.name>.<if(e.hasDocumentation)> <e.documentation><endif> */
export type <e.name> = <e.members:enumeration_case();separator=" | ">;

/**
 * UN TYPE ET UNE VALEUR SOUS LE MÊME NOM, ce que TypeScript permet et qui dit exactement ce
 * qu'on veut : `<e.name>` annote, `<e.name>.<first(e.members).name>` désigne, `<e.name>.wrap` convertit. Le pack en
 * fait une classe qui enveloppe une `ValueEnumeration` ; une union de littéraux se vérifie
 * mieux et ne coûte aucun objet.
 */
export const <e.name> = {
<e.members:enumeration_member();separator=",\n">,

    type(): dsviper.TypeEnumeration {
        return (<e.name;format="lsc">Type ??= definitions().checkEnumeration(<e.name;format="usc">));
    },

    wrap(value: dsviper.Value): <e.name> {
        return dsviper.ValueEnumeration.cast(value).name() as <e.name>;
    },

    /** Depuis le nom d'un cas, et depuis rien d'autre. */
    fromStr(name: string): <e.name> {
        if (typeof name !== "string") {
            throw new TypeError(`${name} n'est pas un nom de cas`);
        }
        return <e.name>.wrap(new dsviper.ValueEnumeration(<e.name>.type(), name));
    },

    /** Le nom d'un cas — qui *est* le cas, puisqu'un littéral porte son propre nom. */
    name(held: <e.name>): string {
        return held;
    },

    /** Le rang d'un cas, tel que le modèle les numérote. */
    index(held: <e.name>): number {
        return <e.name>.type().cases().findIndex((c) => c.name() === held);
    },

    /** La valeur du runtime derrière un cas — ce qui porte l'encodage et l'empreinte. */
    value(held: <e.name>): dsviper.ValueEnumeration {
        return new dsviper.ValueEnumeration(<e.name>.type(), held);
    },

    encode(held: <e.name>): dsviper.ValueBlob {
        return dsviper.Value.encode(<e.name>.value(held));
    },

    decode(blob: dsviper.ValueBlob): <e.name> {
        return <e.name>.wrap(dsviper.Value.decode(blob, <e.name>.type(), definitions()));
    },

    hexdigest(held: <e.name>): string {
        return dsviper.Value.hexdigest(<e.name>.value(held));
    },
};
>>

enumeration_case(m) ::= <%"<m.name>"%>
enumeration_member(m) ::= <<    <m.name;format="usc">: "<m.name>">>

structure(s, u) ::= <<
let <s.name;format="lsc">Type: dsviper.TypeStructure | undefined;

/** <u.name>::<s.name>.<if(s.hasDocumentation)> <s.documentation><endif> */
export class <s.name> extends Proxy\<dsviper.ValueStructure> {
    static type(): dsviper.TypeStructure {
        return (<s.name;format="lsc">Type ??= definitions().checkStructure(<s.name;format="usc">));
    }

    constructor(value?: dsviper.ValueStructure | Record\<string, dsviper.InputValue>) {
        if (value instanceof dsviper.ValueStructure) {
            if (!value.type().equals(<s.name>.type())) {
                throw new TypeError("cette valeur n'est pas un <u.name>::<s.name>");
            }
            super(value);
        } else {
            super(new dsviper.ValueStructure(<s.name>.type(), value));
        }
    }

    static wrap(value: dsviper.Value): <s.name> {
        return new <s.name>(dsviper.ValueStructure.cast(value));
    }

    static decode(blob: dsviper.ValueBlob): <s.name> {
        return new <s.name>(dsviper.ValueStructure.cast(
            dsviper.Value.decode(blob, <s.name>.type(), definitions())));
    }

<s.fields:field(s);separator="\n\n">
}
>>

// LE CHAMP EST UN ACCESSEUR, ET C'EST TOUT CE QU'IL EST. `wrap` lit le type que la valeur
// porte et rend la classe qui va avec, ou une vue qui enveloppe ses éléments ; il n'y a donc
// pas à distinguer ici une structure d'un `vector<Colour>`, et aucune classe de conteneur n'a
// à être générée.
field(f, s) ::= <<
    get <f.name;format="lf">(): <f.bindingType.annotation> {
        <read(f)>
    }

    set <f.name;format="lf">(value: <f.bindingType.annotation>) {
        <write(f)>
    }
>>

read(f) ::= <%<if(f.bindingType.useProxy)>return wrap(this.value.at("<f.name>", false));<else>return this.value.at("<f.name>") as <f.bindingType.annotation>;<endif>%>
// LA CONVERSION EXPLICITE EST POUR `any`. Un champ du modèle déclaré `any` s'annote `unknown`
// -- le mot qui dit « je ne sais pas » sans ouvrir la porte à tout, contrairement à `any` --
// et `unknown` ne s'assigne à rien sans être affirmé. Les autres primitifs la traversent sans
// rien changer.
write(f) ::= <%setField(this.value, "<f.name>", value);%>

// LE PACK NOMME CHAQUE ENTRÉE ET CHAQUE SORTIE D'UN CLUB. `as_(cls)` dit la même chose pour
// tous les membres, y compris ceux qu'un modèle ajoutera ; les noms restent parce qu'ils se
// lisent -- `KlubKey.fromConceptCKey(k)` dit lequel, `as_` demande à l'appelant de le savoir.
club_from(cm, c) ::= <<
    /** La clé d'un membre, vue comme celle du club. */
    static from<cm.asNameInNamespace>Key(key: Proxy\<dsviper.ValueKey> | dsviper.ValueKey): <c.name>Key {
        return new <c.name>Key(key);
    }
>>

club_to(cm, c) ::= <<
    /** La clé vue comme celle de ce membre, ou `undefined` si l'instance n'en est pas un. */
    to<cm.asNameInNamespace>Key(): <cm.bindingInNamespace> | undefined {
        return this.as(<cm.bindingInNamespace>);
    }
>>
