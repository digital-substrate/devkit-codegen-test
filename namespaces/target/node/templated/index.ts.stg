// Ce qu'un module de paquet expose — du modèle, d'une unité, d'un pool.
//
// UN SEUL FICHIER POUR LES TROIS, PARCE QUE C'EST LE MÊME FICHIER. Chaque paquet a son point
// d'entrée, et ce qu'il contient dépend de ce qu'il ouvre : le modèle ouvre ses définitions,
// une unité ouvre ses types, un pool ouvre son client.
//
// ET IL NE PORTE QUE DES RÉEXPORTS. Un point d'entrée qui importerait `attachments` ferait de
// l'import d'une unité l'import de tout ce qu'elle atteint, et deux unités qui se référencent
// par un attachment deviendraient un cycle.

model(m) ::= <<
<preamble(m)>
/**
 * <m.namespace> — le modèle, et ce qu'aucune unité ne peut revendiquer.
 *
 * UN NAMESPACE EST UN MODULE, ET C'EST GRATUIT. `ModelA::Colour` est `<m.namespace;format="lsc">/model_a` et
 * `ModelB::Colour` est `<m.namespace;format="lsc">/model_b` : les deux coexistent sans qu'un nom bouge.
 *
 * CE QUI RESTE AU SOCLE EST PLUS PETIT QU'EN C++. Là-bas il portait `encode`/`decode` parce
 * qu'une valeur C++ et une `Value` du runtime sont deux choses qu'il faut faire passer l'une
 * dans l'autre ; ici une valeur générée *est* une Value. Il ne reste que les définitions.
 */
import dsviper from "@digitalsubstrate/dsviper";

import { B64_DEFINITIONS } from "./resources.js";

let cached: dsviper.DefinitionsConst | undefined;

/** Le modèle, tel que le runtime le connaît — le document embarqué, décodé au chargement. */
export function definitions(): dsviper.DefinitionsConst {
    if (cached === undefined) {
        cached = dsviper.Definitions.decode(dsviper.ValueBlob.base64Decode(B64_DEFINITIONS)).const();
    }
    return cached;
}
>>

unit(u) ::= <<
<preamble(u.model)>
/**
 * <u.name> — ce que cette unité expose.
 *
 * Les classes vivent dans `data`, les attachments dans `attachments`, et le second n'est pas
 * réexporté ici : un point d'entrée qui l'importerait ferait de l'import d'une unité l'import
 * de tout ce qu'elle atteint, et deux unités liées par un attachment deviendraient un cycle.
 */
export * from "./data.js";
>>

pool(p) ::= <<
<preamble(p.model)>
/**
 * <p.name> — ce que ce pool expose.
 *
 * Un pool est une unité, donc un module, et son point d'entrée ne porte que des réexports
 * comme celui de n'importe quelle autre.
 */
export * from "./pool.js";
>>

attachment_pool(p) ::= <<
<pool(p)>
>>

preamble(m) ::= <<
// <m.generated>

>>
