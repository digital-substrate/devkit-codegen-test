]
[variantFunctions
<m.variantFunctions:T_TemplateVariantFunction();separator="\n">
]
[functionPools
<m.functionPools:T_TemplateFunctionPool();separator="\n">
]
[attachmentFunctionPools
<m.attachmentFunctionPools:T_TemplateAttachmentFunctionPool();separator="\n">
]
>>

