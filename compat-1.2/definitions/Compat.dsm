namespace Compat {f966a89e-f39c-4579-bd0e-5bd3812e39c1} {

// FIGÉ. Ce modèle est celui qu'une base 1.2 a enregistré en elle-même ; le changer ferait
// relire une base par un modèle qui n'est plus le sien. Une forme de plus se déclare ici
// seulement avec une base réécrite par write_1_2.py, sous un runtime 1.2.

concept Probe;
concept Other;

enum Shade {
  light,
  medium,
  dark
};

struct Point {
  float x;
  double y;
};

// Une structure qui en contient une autre, une mat non carrée et une énumération : le type
// de chaque champ vient des définitions.
struct Record {
  string name;
  Point origin;
  mat<uint8,2,3> grid;
  Shade shade;
  vector<int16> samples;
};

// Numbers -- des valeurs dont chaque octet diffère, pour qu'un ordre d'octets inversé se lise.
attachment<Probe, bool> docBool;
attachment<Probe, uint8> docUInt8;
attachment<Probe, uint16> docUInt16;
attachment<Probe, uint32> docUInt32;
attachment<Probe, uint64> docUInt64;
attachment<Probe, int8> docInt8;
attachment<Probe, int16> docInt16;
attachment<Probe, int32> docInt32;
attachment<Probe, int64> docInt64;
attachment<Probe, float> docFloat;
attachment<Probe, double> docDouble;

// Ids, string, blob
attachment<Probe, uuid> docUUId;
attachment<Probe, blob_id> docBlobId;
attachment<Probe, commit_id> docCommitId;
attachment<Probe, string> docString;
attachment<Probe, blob> docBlob;

// Vec & Mat -- non carrée, pour qu'une transposition se lise.
attachment<Probe, vec<int32,3>> docVec;
attachment<Probe, mat<uint8,2,3>> docMat;

// Containers -- leur type se déduit de la forme C++, pas des définitions.
attachment<Probe, tuple<uint8, string>> docTuple;
attachment<Probe, optional<uint16>> docOptional;
attachment<Probe, vector<mat<uint8,2,3>>> docVectorMat;
attachment<Probe, set<string>> docSet;
attachment<Probe, map<string, Point>> docMap;
attachment<Probe, xarray<uint8>> docXArray;
attachment<Probe, variant<string, uint8, Point>> docVariant;
attachment<Probe, any> docAny;

// Entities
attachment<Probe, Shade> docShade;
attachment<Probe, Point> docPoint;
attachment<Probe, Record> docRecord;
attachment<Probe, key<Other>> docKey;
attachment<Probe, map<key<Other>, vector<Record>>> docNested;

};
